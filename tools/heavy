#!/usr/bin/env bash
set -u
[ $# -gt 0 ] || { echo "usage: tools/heavy COMMAND [ARG]..." >&2; exit 2; }
hour=$(date +%-H)
if [ "$hour" -ge 22 ] || [ "$hour" -lt 8 ]; then jobs=3; else jobs=5; fi
jobs=${MERL_HEAVY_JOBS:-$jobs}
minutes=${MERL_HEAVY_MINUTES:-45}
export CARGO_BUILD_JOBS=$jobs RUST_TEST_THREADS=$jobs
kill_tree() {
  local child
  for child in $(pgrep -P "$1"); do kill_tree "$child"; done
  kill "$1" 2>/dev/null
}
run= watchdog=
stop() {
  for pid in $run $watchdog; do kill_tree "$pid"; done
  exit "$1"
}
trap 'stop 130' INT
trap 'stop 143' TERM HUP
while :; do
  for slot in 1 2; do
    lockf -k -s -t 0 "/tmp/merl-heavy.$slot.lock" nice -n 15 "$@" <&0 &
    run=$!
    { sleep $((minutes * 60)); echo "tools/heavy: killed after $minutes min: $*" >&2; kill_tree "$run"; } &
    watchdog=$!
    wait "$run"
    rc=$?
    kill_tree "$watchdog"
    wait "$watchdog" 2>/dev/null
    run= watchdog=
    [ "$rc" -eq 75 ] || exit "$rc"
  done
  sleep 5
done
