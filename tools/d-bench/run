#!/usr/bin/env python3
"""The `d` bench: press `d` on recorded cursors in pinned real projects, score merl's answer
against the recorded one, print a table per language and diff it against the baseline.

  tools/d-bench/run [--lang L[,L]] [--project P] [--cache DIR] [--merl FILE] [--update-baseline]
  tools/d-bench/run --selftest     the scoring, the gate and record.py's tokenizer on made-up rows, no clone (CI runs it)

--cache            where the projects are cloned (default $D_BENCH_CACHE or ~/.cache/merl-d-bench).
                   A clone already at its pinned commit and installed is only read, never touched.
--merl FILE        score a previous run's output (`last-merl.tsv` in the cache) instead of
                   running merl again.
--update-baseline  write this run's rows into baseline.tsv and its table into baseline.md.

Exits 1 when any cursor scores worse than in the baseline (ok < pick-hit < miss < WRONG), or a
cursor that is not scored newly jumps away from its recorded answer (skip-WRONG, no-answer-WRONG,
on-decl-WRONG): a gain elsewhere does not pay for it.
"""
import argparse, datetime, importlib.util, os, re, subprocess, sys
from collections import Counter, defaultdict

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))
RANK = {"ok": 0, "pick-hit": 1, "pick-miss": 2, "none": 2, "WRONG": 3}
SCORED = list(RANK)
PNPM_PEERS = re.compile(r"(/node_modules/\.pnpm/(?:@[^/+]+\+)?[^/@]+@[^/_]+)_[^/]+")


def tsv(path):
    return [l.rstrip("\n").split("\t") for l in open(path) if l.strip() and not l.startswith("#")]


def sh(cmd, cwd):
    print(f"  $ {cmd}", file=sys.stderr)
    subprocess.run(cmd, cwd=cwd, shell=True, check=True)


def ensure(cache, name, url, commit, install):
    d = os.path.join(cache, name)
    installed = os.path.join(d, ".git", "merl-bench-installed")
    head = ""
    if os.path.isdir(os.path.join(d, ".git")):
        head = subprocess.run(["git", "-C", d, "rev-parse", "HEAD"], capture_output=True,
                              text=True).stdout.strip()
        if head != commit:
            print(f"{name}: at {head[:7]}, moving to the pinned {commit[:7]}", file=sys.stderr)
    else:
        print(f"{name}: cloning {url} at {commit[:7]}", file=sys.stderr)
        os.makedirs(d, exist_ok=True)
        sh(f"git init -q && git remote add origin {url}", d)
    if head != commit:
        if os.path.exists(installed):
            os.remove(installed)
        sh(f"git fetch -q --depth 1 origin {commit} && git checkout -q --detach {commit}", d)
    if install != "-" and not os.path.exists(installed):
        sh(install, d)
        open(installed, "w").close()
    return d


def same_file(a, b):
    return PNPM_PEERS.sub(r"\1", a) == PNPM_PEERS.sub(r"\1", b)


def modkey(p):
    base = re.sub(r"(\.d)?\.[A-Za-z]+$", "", p)
    return "/".join(base.split("/")[-2:])


def targets(s, root):
    out = []
    for t in filter(None, s.split(";")):
        p, _, ln = t.rpartition(":")
        p = os.path.expanduser(p)
        out.append((os.path.realpath(os.path.join(root, p)), int(ln)))
    return out


def verdict(cur, ans, got, root):
    rel, line = cur[2], int(cur[3])
    want = targets(ans[1], root) if ans else []
    here = os.path.realpath(os.path.join(root, rel))
    external = not all(p.startswith(root + "/") for p, _ in want)

    def hit(g, any_line=False):
        return any(abs(g[1] - ln) <= 1 or any_line and external if same_file(g[0], p)
                   else external and modkey(g[0]) == modkey(p) for p, ln in want)

    outcome, found = got
    unscored = ("skip" if ans and ans[2] else "no-answer" if not want
                else "on-decl" if any(p == here and ln == line for p, ln in want) else "")
    if unscored:
        return unscored + "-WRONG" if outcome == "jump" and not hit(found[0], True) else unscored
    if outcome == "jump":
        return "ok" if hit(found[0]) else "WRONG"
    if outcome == "picker":
        return "pick-hit" if any(hit(g) for g in found) else "pick-miss"
    return "none"


def byte_col(line, col):
    return len(line[:col].encode())


def kind(v):
    return "scored" if v in RANK else v.removesuffix("-WRONG")


def rank(v):
    return RANK.get(v, 3 * v.endswith("-WRONG"))


def moved(base, now, sign):
    return [(rank(now[i][1]) - rank(b[1]), now[i][1].endswith("WRONG"), i) for i, b in base.items()
            if i in now and kind(b[1]) == kind(now[i][1]) and sign * (rank(now[i][1]) - rank(b[1])) > 0]


def worse_rows(base, now):
    return moved(base, now, 1)


def pct(n, tot):
    return f"{n} ({100 * n / tot:.0f}%)" if tot else "0"


def quantile(ms, q):
    ms = sorted(ms)
    return ms[min(len(ms) - 1, int(len(ms) * q))] if ms else 0.0


def table(rows, projects):
    by = defaultdict(list)
    for r in rows:
        by[r[0]].append(r)
    out = ["| language (project) | scored | direct hit | picker with the answer | wrong jump "
           "| miss | not scored | wrong jump, not scored | p50 ms | p90 ms |",
           "|---|---|---|---|---|---|---|---|---|---|"]
    for lang in sorted(by, key=lambda l: [p[1] for p in projects].index(l)):
        c = Counter(r[2] for r in by[lang])
        n = sum(c[k] for k in SCORED)
        stray = sum(v for k, v in c.items() if k.endswith("-WRONG"))
        ms = [r[3] for r in by[lang]]
        name = ", ".join(p[0] for p in projects if p[1] == lang)
        out.append(f"| {lang} ({name}) | {n} | {pct(c['ok'], n)} | {pct(c['pick-hit'], n)} | "
                   f"{pct(c['WRONG'], n)} | {pct(c['pick-miss'] + c['none'], n)} | "
                   f"{len(ms) - n} | {stray} | {quantile(ms, .5):.1f} | {quantile(ms, .9):.1f} |")
    return out


def selftest():
    root = "/p"
    dep = "/home/u/.venv/lib/requests/api.py"
    cur = ["x0001", "proj", "a.py", "3", "4"]
    ans = lambda target: ["x0001", target, ""]
    jump = lambda path, line: ("jump", targets(f"{path}:{line}", root))
    assert verdict(cur, ans("b.py:10"), jump("/p/b.py", 11), root) == "ok"
    assert verdict(cur, ans("b.py:10"), jump("/p/b.py", 40), root) == "WRONG"
    assert verdict(cur, ans(f"{dep}:50"), jump("/other/venv/lib/requests/api.py", 7), root) == "ok"
    assert verdict(cur, ans(f"{dep}:50"), jump(dep, 50), root) == "ok"
    assert verdict(cur, ans(f"{dep}:50"), jump(dep, 90), root) == "WRONG"
    assert verdict(cur, ans("b.py:10"), ("picker", targets("c.py:1;b.py:10", root)), root) == "pick-hit"
    pnpm = "node_modules/.pnpm/{}/node_modules/astro/env.d.ts:7"
    copy = lambda d: ans(pnpm.format(d))
    got = lambda d: ("picker", targets("c.py:1;" + pnpm.format(d), root))
    assert verdict(cur, copy("astro@7.2.10_@astrojs+md@7.3.0__ffe8"), got("astro@7.2.10_vite@7__06e3"), root) == "pick-hit"
    assert verdict(cur, copy("@astrojs+check@0.9.10_ts@6"), got("@astrojs+check@0.9.10"), root) == "pick-hit"
    assert verdict(cur, copy("astro@7.2.10_vite@7__06e3"), got("astro@7.2.11_vite@7__06e3"), root) == "pick-miss"
    assert verdict(cur, copy("astro@7.2.10_vite@7"), got("astro-x@7.2.10_vite@7"), root) == "pick-miss"
    assert byte_col('label = _("Ärger") + format_label(x)', 21) == 22
    base = {"go1": ["go1", "ok"], "go2": ["go2", "WRONG"], "go3": ["go3", "pick-hit"]}
    swap = {"go1": ["go1", "WRONG"], "go2": ["go2", "ok"], "go3": ["go3", "pick-hit"]}
    assert [w[2] for w in worse_rows(base, swap)] == ["go1"]
    lost = {"go1": ["go1", "ok"], "go2": ["go2", "WRONG"], "go3": ["go3", "none"]}
    assert [w[2] for w in worse_rows(base, lost)] == ["go3"]
    assert worse_rows(base, base) == []
    skip = lambda target: ["x0001", target, "debatable"]
    assert verdict(cur, skip(f"{dep}:50"), jump(dep, 90), root) == "skip"
    assert verdict(cur, skip(f"{dep}:50"), jump("/p/b.py", 50), root) == "skip-WRONG"
    assert verdict(cur, skip("b.py:10"), jump("/p/b.py", 40), root) == "skip-WRONG"
    assert verdict(cur, skip("b.py:10"), ("picker", targets("c.py:1", root)), root) == "skip"
    assert verdict(cur, ans(""), jump("/p/b.py", 40), root) == "no-answer-WRONG"
    assert verdict(cur, ans(""), ("none", []), root) == "no-answer"
    assert verdict(cur, ans("a.py:3"), jump("/p/a.py", 3), root) == "on-decl"
    assert verdict(cur, ans("a.py:3"), jump("/p/b.py", 3), root) == "on-decl-WRONG"
    unscored = {"go1": ["go1", "skip"], "go2": ["go2", "no-answer-WRONG"], "go3": ["go3", "on-decl"]}
    strays = {"go1": ["go1", "skip-WRONG"], "go2": ["go2", "no-answer"], "go3": ["go3", "ok"]}
    assert worse_rows(unscored, strays) == [(3, True, "go1")]
    assert [w[2] for w in moved(unscored, strays, -1)] == ["go2"]
    sys.dont_write_bytecode = True
    spec = importlib.util.spec_from_file_location("record", os.path.join(HERE, "record.py"))
    record = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(record)
    words = lambda line, lang: [t[2] for t in record.code_tokens(line, record.SPEC[lang])]
    assert words("x = A' * b #= note =# + push!(v, 'c') # tail", "julia") == ["x", "A", "b", "push!", "v"]
    assert words("if a!=b && c==d", "julia") == ["if", "a", "b", "c", "d"]
    assert words("x = y / 2 /* note */ + z // tail", "c") == ["x", "y", "z"]
    assert words("f('a', g($y)); # tail", "php") == ["f", "g"]
    assert words("(foo? 'a \"b ;\\\"\" ?\\( #'bar) ; tail", "elisp") == ["foo?", "a", "bar"]
    assert words("(set! x #\\( #| c |# y-2) ; tail", "racket") == ["set!", "x", "y-2"]
    sh = lambda text: [(s, w) for _, _, s, w in record.sh_words(text, set(record.KW["bash"]))]
    assert sh('f() { echo "$a ${b} lit" | grep x; helper "$c"; }  # $d\nsource "$root/lib/util.bash"\n'
              'cat <<EOF\n$e\nEOF\nrun g\n') == [("path", "util"), ("name", "a"), ("name", "b"), ("call", "helper"),
                                                ("name", "c"), ("name", "root"), ("call", "run"), ("call", "g")]
    lua = lambda text: [(s, w) for _, _, s, w in record.lua_words(text, set(record.KW["lua"]))]
    assert lua('local util = require("a.util") -- c\n--[[ x.y ]] local s = [[ z ]]\n'
               'return util.join(s, M:pick "k")\n') == [("path", "util"), ("call", "require"), ("name", "util"),
                                                       ("member", "join"), ("member", "pick")]
    print("selftest ok")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawTextHelpFormatter)
    ap.add_argument("--lang")
    ap.add_argument("--project")
    ap.add_argument("--cache", default=os.environ.get("D_BENCH_CACHE",
                                                      os.path.expanduser("~/.cache/merl-d-bench")))
    ap.add_argument("--merl")
    ap.add_argument("--update-baseline", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()

    projects = tsv(os.path.join(HERE, "projects.tsv"))
    pick = [p for p in projects if (not a.lang or p[1] in a.lang.split(","))
            and (not a.project or p[0] == a.project)]
    if not pick:
        sys.exit("no project matches")
    cache = os.path.realpath(os.path.expanduser(a.cache))
    os.makedirs(cache, exist_ok=True)
    servers = os.path.realpath(os.environ.get("D_BENCH_SERVERS", os.path.join(cache, "servers")))
    os.environ["D_BENCH_SERVERS"] = servers
    dart_bin = os.path.join(servers, "dart-sdk", "bin")
    if os.path.isdir(dart_bin):
        os.environ["PATH"] = dart_bin + os.pathsep + os.environ["PATH"]
        os.environ["PUB_CACHE"] = os.path.join(servers, "dart-pub-cache")
    elif any(p[1] == "dart" for p in pick):
        sys.exit(f"the dart row needs the Dart SDK in {dart_bin}: tools/d-bench/install-servers.sh fetches it")
    roots, cursors, answers = {}, [], {}
    for name, lang, url, commit, install in pick:
        roots[name] = os.path.realpath(ensure(cache, name, url, commit, install))
        cursors += [(lang, c) for c in tsv(os.path.join(HERE, "cursors", f"{lang}.tsv")) if c[1] == name]
        answers.update({r[0]: r + [""] * (4 - len(r)) for r in tsv(os.path.join(HERE, "answers", f"{lang}.tsv"))})

    merl_out = a.merl or os.path.join(cache, "last-merl.tsv")
    load_before = os.popen("sysctl -n vm.loadavg 2>/dev/null").read().strip()
    if not a.merl:
        bench_in = os.path.join(cache, "last-cursors.tsv")
        lines = {}
        with open(bench_in, "w") as f:
            for _, c in cursors:
                path = os.path.join(roots[c[1]], c[2])
                if path not in lines:
                    lines[path] = open(path, encoding="utf-8", errors="replace").read().split("\n")
                col = byte_col(lines[path][int(c[3]) - 1], int(c[4]))
                f.write("\t".join([c[0], roots[c[1]], c[2], c[3], str(col)]) + "\n")
        print(f"load {load_before}; {len(cursors)} cursors", file=sys.stderr)
        subprocess.run(["cargo", "test", "--release", "--bin", "merl", "app::tests::d_bench::d_bench", "--", "--exact", "--ignored", "--quiet"],
                       cwd=REPO, check=True, env={**os.environ, "BENCH_IN": bench_in, "BENCH_OUT": merl_out})
    merl = {r[0]: r + [""] * (5 - len(r)) for r in tsv(merl_out)}

    rows, detail = [], []
    for lang, c in cursors:
        if c[0] not in merl:
            continue
        m = merl[c[0]]
        got = (m[1], targets(m[4], roots[c[1]]))
        v = verdict(c, answers.get(c[0]), got, roots[c[1]])
        rows.append((lang, c[0], v, float(m[2])))
        rel = lambda p: os.path.relpath(p, roots[c[1]]) if p.startswith(roots[c[1]] + "/") else p
        shown = ";".join(f"{rel(p)}:{l}" for p, l in got[1][:3])
        detail.append([c[0], v, m[1], m[2], f"{c[2]}:{c[3]}:{c[4]}", c[6], m[3], shown,
                       answers.get(c[0], ["", ""])[1]])
    with open(os.path.join(cache, "last-score.tsv"), "w") as f:
        f.write("# id\tverdict\toutcome\tms\tcursor\tword\tstatus\tmerl (first 3)\tanswer\n")
        f.writelines("\t".join(d) + "\n" for d in detail)
    tab = table(rows, projects)
    print("\n".join(tab))
    stray = [d for d in detail if d[1].endswith("-WRONG")]
    if stray:
        print(f"\nwrong jumps on rows not scored: {len(stray)}")
        for d in stray:
            print(f"  {d[0]} {d[4]} {d[5]}: {d[1]}  (jump {d[7]}, answer {d[8] or '-'})")

    base_path = os.path.join(HERE, "baseline.tsv")
    base = {r[0]: r for r in tsv(base_path)} if os.path.exists(base_path) else {}
    now = {d[0]: d for d in detail}
    worse = worse_rows(base, now)
    better = len(moved(base, now, -1))
    fail = False
    if base:
        print(f"\nagainst the baseline: {len(worse)} worse, {better} better")
        for lang in dict.fromkeys(r[0] for r in rows):
            ids = [r[1] for r in rows if r[0] == lang and r[1] in base]
            cnt = lambda src, k: sum(1 for i in ids if ("stray" if src[i][1].endswith("-WRONG") else src[i][1]) == k)
            ok, wr, st = [(cnt(base, k), cnt(now, k)) for k in ("ok", "WRONG", "stray")]
            flag = any(i in ids for _, _, i in worse)
            fail |= flag
            print(f"  {lang:7} direct hit {ok[0]}->{ok[1]}  wrong jump {wr[0]}->{wr[1]}"
                  f"  not scored {st[0]}->{st[1]}" + ("  WORSE" if flag else ""))
        for _, _, i in sorted(worse, key=lambda w: (not w[1], -w[0], w[2])):
            b, n = base[i], now[i]
            print(f"  {i} {n[4]} {n[5]}: {b[1]} -> {n[1]}  ({n[2]} {n[7] or n[6]})")

    if a.update_baseline:
        keep = {i: r for i, r in base.items() if i not in now}
        merged = sorted({**keep, **{i: d[:4] for i, d in now.items()}}.items())
        with open(base_path, "w") as f:
            f.write("# id\tverdict\toutcome\tms (tools/d-bench/run --update-baseline)\n")
            f.writelines("\t".join(r[:4]) + "\n" for _, r in merged)
        all_rows = [(next(p[1] for p in projects if r[0].startswith(p[1]) and r[0][len(p[1]):].isdigit()),
                     r[0], r[1], float(r[3])) for _, r in merged]
        head = subprocess.run(["git", "-C", REPO, "log", "-1", "--format=%h"], capture_output=True,
                              text=True).stdout.strip()
        load_after = os.popen("sysctl -n vm.loadavg 2>/dev/null").read().strip()
        with open(os.path.join(HERE, "baseline.md"), "w") as f:
            f.write(f"# `d` bench baseline\n\nmerl at `{head}`, {datetime.date.today()}, release build, "
                    f"`vm.loadavg` {load_before} before the run, {load_after} after.\n\n" + "\n".join(table(all_rows, projects)) + "\n")
    sys.exit(1 if fail else 0)


if __name__ == "__main__":
    main()
