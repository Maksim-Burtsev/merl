#!/usr/bin/env python3
"""The fold bench: `f` pressed on the lines of real projects, against a reference.

    tools/fold-bench/run [--lang python,go] [--cache DIR] [--show N] [--update-baseline]

The projects are cloned at a pinned commit into the cache (default $D_BENCH_CACHE or
~/.cache/merl-d-bench, shared with tools/d-bench). The reference:

    python       Python's own `ast` and `tokenize`, run here on every line of four projects
    the rest     folds/LANG.tsv, what Neovim folds with nvim-treesitter's `folds.scm` in the
                 projects of tools/d-bench/projects.tsv, recorded once by record.py: every
                 line that starts a fold, and the last line `zc` hides there

merl presses `f` on each line through the ignored test `fold_bench` (src/app/tests/fold_bench.rs).
A language whose `f` is off (`no fold rules for .EXT`) is pressed with the rules forced on, the
plain shape every language without rules of its own gets, and marked `off`: its row is the
starting line, never a failure. For a language that is on, the run exits 1 under 99 % exact or
on any line worse than baseline.tsv, master's lines that are not exact (exact, then nothing
folded, then a wrong range). --update-baseline writes the languages it ran into baseline.tsv.
The lines that differ are written to `last-fold.tsv` in the cache; --show N prints N of them.

Python's reference, per line:

    def / class / if / elif / else / for / while / with / try / except / finally / match / case
                 the header line folds its suite, header kept, through the suite's last line
    bracket      a line ending in ( [ { folds to the closing bracket's line when that line only
                 closes, else to the line before it
    string       the first line of a multi-line string folds to its last line
    import       any line of a run of two or more imports folds the whole run
    inside       any other line inside a def or class, blank lines included, folds the innermost
                 def or class around it; a blank line after a method's last statement is the
                 class's

Known to differ in Python, 2 of 270,726 lines: rich/tests/test_inspect.py 442 and 452, a
multi-line string whose closing line opens `% (`. merl folds the string and the bracket as one;
the reference folds them apart.
"""
import argparse, ast, io, os, statistics, subprocess, sys, tempfile, time, tokenize

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from record import ensure, projects

PROJECTS = [
    ("httpx", "https://github.com/encode/httpx.git", "b5addb64f0161ff6bfe94c124ef76f6a1fba5254"),
    ("paperless-ngx", "https://github.com/paperless-ngx/paperless-ngx.git",
     "6a5d06ee26a4620e6c8452870f157998d5b35050"),
    ("fastapi", "https://github.com/fastapi/fastapi.git", "28a206107302ee20ce6a9a876d05a258c1c8d328"),
    ("rich", "https://github.com/Textualize/rich.git", "9d8f9a372cc5916fd4781fec207ced7ddac2f08f"),
]
HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
RANK = {"exact": 0, "nothing": 1, "wrong": 2}
CLOSERS = set(")]}},;: ")


def suite_end(stmts):
    return max(s.end_lineno for s in stmts)


def keyword_line(lines, word, before, col):
    for n in range(before - 1, 0, -1):
        text = lines[n - 1]
        if len(text) - len(text.lstrip()) == col and text.lstrip().startswith(word):
            return n
    return None


def reference(src):
    tree = ast.parse(src)
    lines = src.split("\n")
    exp = {}

    def add(line, h, e, kind):
        if line and e > h and line not in exp:
            exp[line] = (h, e, kind)

    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            add(node.lineno, node.lineno, node.end_lineno, "def / class")
        if isinstance(node, ast.If):
            add(node.lineno, node.lineno, suite_end(node.body), "if / elif / else")
            elif_ = (len(node.orelse) == 1 and isinstance(node.orelse[0], ast.If)
                     and lines[node.orelse[0].lineno - 1].lstrip().startswith("elif"))
            if node.orelse and not elif_:
                n = keyword_line(lines, "else", node.orelse[0].lineno, node.col_offset)
                add(n, n, suite_end(node.orelse), "if / elif / else")
        if isinstance(node, (ast.For, ast.AsyncFor, ast.While)):
            add(node.lineno, node.lineno, suite_end(node.body), "for / while")
            if node.orelse:
                n = keyword_line(lines, "else", node.orelse[0].lineno, node.col_offset)
                add(n, n, suite_end(node.orelse), "for / while")
        if isinstance(node, (ast.With, ast.AsyncWith)):
            add(node.lineno, node.lineno, suite_end(node.body), "with")
        if isinstance(node, (ast.Try, getattr(ast, "TryStar", ast.Try))):
            add(node.lineno, node.lineno, suite_end(node.body), "try / except / finally")
            for h in node.handlers:
                add(h.lineno, h.lineno, suite_end(h.body), "try / except / finally")
            if node.orelse:
                n = keyword_line(lines, "else", node.orelse[0].lineno, node.col_offset)
                add(n, n, suite_end(node.orelse), "try / except / finally")
            if node.finalbody:
                n = keyword_line(lines, "finally", node.finalbody[0].lineno, node.col_offset)
                add(n, n, suite_end(node.finalbody), "try / except / finally")
        if isinstance(node, getattr(ast, "Match", ())):
            add(node.lineno, node.lineno, node.end_lineno, "match / case")
            for c in node.cases:
                n = next(k for k in range(c.pattern.lineno, 0, -1)
                         if lines[k - 1].lstrip().startswith("case"))
                add(n, n, suite_end(c.body), "match / case")

    for node in ast.walk(tree):
        for field in ("body", "orelse", "finalbody"):
            stmts = getattr(node, field, None)
            if not isinstance(stmts, list):
                continue
            run = []
            for s in stmts + [None]:
                if isinstance(s, (ast.Import, ast.ImportFrom)):
                    run.append(s)
                    continue
                if len(run) > 1:
                    for r in run:
                        add(r.lineno, run[0].lineno, run[-1].end_lineno, "import")
                run = []

    toks = list(tokenize.generate_tokens(io.StringIO(src).readline))
    ends = (tokenize.NL, tokenize.NEWLINE, tokenize.COMMENT)
    stack = []
    for i, t in enumerate(toks):
        if t.type == tokenize.OP and t.string in "([{":
            stack.append(i)
        elif t.type == tokenize.OP and t.string in ")]}" and stack:
            j = stack.pop()
            o = toks[j]
            if toks[j + 1].type in ends and t.start[0] > o.start[0]:
                close = lines[t.start[0] - 1].split("#")[0].strip()
                e = t.start[0] if close and set(close) <= CLOSERS else t.start[0] - 1
                add(o.start[0], o.start[0], e, "bracket")
    fstart = []
    for t in toks:
        name = tokenize.tok_name[t.type]
        if name == "FSTRING_START":
            fstart.append(t)
        elif name == "FSTRING_END" and fstart:
            s = fstart.pop()
            if not fstart:
                add(s.start[0], s.start[0], t.end[0], "string")
        elif t.type == tokenize.STRING:
            add(t.start[0], t.start[0], t.end[0], "string")

    spans = sorted(((n.lineno, n.end_lineno) for n in ast.walk(tree)
                    if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))),
                   key=lambda s: s[1] - s[0])
    for line in range(1, len(lines) + 1):
        if line in exp:
            continue
        inner = next((s for s in spans if s[0] < line <= s[1]), None)
        if inner:
            exp[line] = (inner[0], inner[1], "inside")
    return exp


def python_rows(cache):
    for name, url, commit in PROJECTS:
        d = ensure(cache, name, url, commit)
        for f in subprocess.run(["git", "-C", d, "ls-files", "*.py"], capture_output=True, text=True).stdout.split():
            try:
                exp = reference(open(os.path.join(d, f), encoding="utf-8").read())
            except (SyntaxError, UnicodeDecodeError, tokenize.TokenError, ValueError):
                continue
            for line, (h, e, kind) in sorted(exp.items()):
                yield f"{name}/{f}", line, h, e, kind


def recorded_rows(cache, lang):
    every, ready = projects(), set()
    for row in open(os.path.join(HERE, "folds", f"{lang}.tsv")).read().splitlines():
        if row.startswith("#"):
            continue
        path, folds = row.split("\t")
        name = path.split("/")[0]
        if name not in ready:
            _, _, url, commit, _ = every[name]
            ensure(cache, name, url, commit)
            ready.add(name)
        for fold in folds.split():
            h, e = map(int, fold.split(":"))
            yield path, h, h, e, lang


def baseline():
    path = os.path.join(HERE, "baseline.tsv")
    rows = [r.split("\t") for r in open(path).read().splitlines() if r and not r.startswith("#")]
    return {(lang, at): status for lang, at, status in rows}


def main():
    recorded = sorted(f[:-4] for f in os.listdir(os.path.join(HERE, "folds")))
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--lang", default=",".join(["python"] + recorded))
    ap.add_argument("--cache", default=os.environ.get("D_BENCH_CACHE", os.path.expanduser("~/.cache/merl-d-bench")))
    ap.add_argument("--show", type=int, default=0)
    ap.add_argument("--update-baseline", action="store_true")
    a = ap.parse_args()
    langs = a.lang.split(",")
    unknown = [l for l in langs if l != "python" and l not in recorded]
    if unknown:
        sys.exit(f"no reference for {', '.join(unknown)}: {', '.join(['python'] + recorded)}")
    cache = os.path.realpath(a.cache)
    os.makedirs(cache, exist_ok=True)
    rows, expect = [], {}
    for lang in langs:
        source = python_rows(cache) if lang == "python" else recorded_rows(cache, lang)
        for path, line, h, e, kind in source:
            rid = str(len(rows))
            rows.append(f"{rid}\t{os.path.join(cache, path)}\t{line}")
            expect[rid] = (lang, path, line, h, e, kind)
    tmp = tempfile.mkdtemp(prefix="fold-bench-")
    bench_in, bench_out = os.path.join(tmp, "in.tsv"), os.path.join(tmp, "out.tsv")
    open(bench_in, "w").write("\n".join(rows) + "\n")
    started = time.time()
    env = {**os.environ, "BENCH_IN": bench_in, "BENCH_OUT": bench_out}
    subprocess.run(["cargo", "test", "--release", "--quiet", "--bin", "merl", "fold_bench", "--", "--ignored"],
                   cwd=ROOT, env=env, check=True, stdout=subprocess.DEVNULL)
    took = time.time() - started
    status, on, micros, wrong = {}, {}, {l: [] for l in langs}, []
    for row in open(bench_out).read().splitlines():
        rid, h, e, state, us, msg = (row.split("\t") + [""])[:6]
        lang, path, line, xh, xe, kind = expect[rid]
        on[lang] = state
        micros[lang].append(int(us))
        verdict = "exact" if (h, e) == (str(xh), str(xe)) else "nothing" if h == "-" else "wrong"
        status[(lang, f"{path}:{line}")] = verdict
        if verdict != "exact":
            wrong.append(f"{lang}\t{path}:{line}\t{kind}\twant {xh}-{xe}\tgot {h}-{e}\t{msg}")
    print(f"{'language':10}{'f':>5}{'lines':>8}{'exact':>8}{'wrong':>8}{'nothing':>9}{'%':>8}{'p50 ms':>8}")
    failed = []
    for lang in langs:
        mine = [v for (l, _), v in status.items() if l == lang]
        n, x = len(mine), mine.count("exact")
        p50 = statistics.median(micros[lang]) / 1000 if micros[lang] else 0
        print(f"{lang:10}{on.get(lang, '-'):>5}{n:8}{x:8}{mine.count('wrong'):8}{mine.count('nothing'):9}"
              f"{100 * x / max(n, 1):8.2f}{p50:8.2f}")
        if on.get(lang) == "on" and x < 0.99 * n:
            failed.append(f"{lang}: {100 * x / n:.2f} % exact, under 99 %")
    print(f"({took:.0f} s for {len(rows)} presses)")
    open(os.path.join(cache, "last-fold.tsv"), "w").write("\n".join(wrong) + "\n")
    for w in wrong[: a.show]:
        print(w)
    base = baseline()
    worse = [f"{lang}\t{at}\t{base.get((lang, at), 'exact')} -> {v}" for (lang, at), v in status.items()
             if on.get(lang) == "on" and RANK[v] > RANK[base.get((lang, at), "exact")]]
    if a.update_baseline:
        kept = {k: v for k, v in base.items() if k[0] not in langs}
        kept.update({k: v for k, v in status.items() if v != "exact" and on.get(k[0]) == "on"})
        head = "# lines not exact on master in the languages whose f is on: language, path:line, verdict\n"
        open(os.path.join(HERE, "baseline.tsv"), "w").write(
            head + "".join(f"{l}\t{at}\t{v}\n" for (l, at), v in sorted(kept.items())))
    elif worse:
        failed.append(f"{len(worse)} lines worse than baseline.tsv:")
        failed += worse
    for f in failed:
        print(f)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
