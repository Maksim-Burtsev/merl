#!/usr/bin/env bash
set -Eeuo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cache=${THEME_BENCH_CACHE:-$HOME/.cache/merl-theme-bench}/themes
extends() {
  awk -v lang="$2" '!/^;/ { exit } /^;+[ \t]*extends[ \t]*$/ { found = 1 }
    $0 ~ "^;+[ \t]*inherits[ \t]*:?[ \t]*" lang "[ \t]*$" { found = 1 } END { exit !found }' "$1"
}
grep -v '^#' "$root/tools/theme-bench/themes.tsv" | while IFS=$'\t' read -r name source _; do
  [ -f "$root/themes/$name.tmTheme" ] && [ "$source" != skip ] || continue
  repo=${source%@*} pin=${source#*@}
  dir=$cache/${repo//\//__}
  if [ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" != "$pin" ]; then
    [ -d "$dir/.git" ] || git init -q "$dir"
    git -C "$dir" fetch -q --depth 1 "https://github.com/$repo.git" "$pin"
    git -C "$dir" checkout -q --detach FETCH_HEAD
  fi
  out=$root/themes/$name.queries
  rm -rf "$out"
  for lang in $(cd "$root/queries" && ls -d */ | tr -d /); do
    files=()
    for f in "$dir/queries/$lang/highlights.scm" "$dir/after/queries/$lang/highlights.scm"; do
      [ -f "$f" ] || continue
      extends "$f" "$lang" || { echo "tools/theme-queries: $f does not extend $lang" >&2; exit 1; }
      files+=("$f")
    done
    [ ${#files[@]} -gt 0 ] || continue
    mkdir -p "$out"
    cat "${files[@]}" > "$out/$lang.scm"
  done
done
