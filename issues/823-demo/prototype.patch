+
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct Since {
+    pub short: String,
+    pub against: String,
+    pub delta: Vec<PathBuf>,
+    pub whole: Vec<PathBuf>,
+    pub left_out: usize,
+}
+
+fn p823_store(root: &Path) -> Option<PathBuf> {
+    Some(dirs(root)?.common_refs_dir.join("merl/p823"))
+}
+
+pub fn p823_tick(root: &Path, branch: &str, rel: &Path, base: &str) {
+    let Some(store) = p823_store(root) else { return };
+    let Ok(merge_base) = git(root, &["merge-base", base, "HEAD"]) else {
+        return;
+    };
+    let Ok(blob) = git(root, &["hash-object", "-w", "--", rel.to_str().unwrap_or("")]) else {
+        return;
+    };
+    let file = store.join("ticks").join(branch);
+    let _ = std::fs::create_dir_all(file.parent().unwrap());
+    let old = std::fs::read_to_string(&file).unwrap_or_default();
+    let mut out: String = old
+        .lines()
+        .filter(|l| l.split('\t').next() != rel.to_str())
+        .map(|l| format!("{l}\n"))
+        .collect();
+    out.push_str(&format!("{}\t{blob}\t{merge_base}\n", rel.display()));
+    let _ = std::fs::write(&file, out);
+}
+
+fn p823_since(root: &Path, base: &str, r: &Review) -> Option<Since> {
+    let store = p823_store(root)?;
+    let git = |args: &[&str]| git(root, args);
+    let head = git(&["rev-parse", "HEAD"]).ok()?;
+    let head_file = store.join("head").join(&r.branch);
+    if std::env::var("MERL_P823_SINCE").is_err() {
+        let _ = std::fs::create_dir_all(head_file.parent()?);
+        let _ = std::fs::write(&head_file, &head);
+        return None;
+    }
+    let mode = std::env::var("MERL_P823").unwrap_or_else(|_| "A".into());
+    if mode == "C" {
+        let old = std::fs::read_to_string(&head_file).ok()?.trim().to_string();
+        if old == head {
+            return None;
+        }
+        let old_mb = git(&["merge-base", base, &old]).ok()?;
+        if old_mb != r.merge_base {
+            return None;
+        }
+        let short = old[..7].to_string();
+        return Some(Since { short, against: old, ..Default::default() });
+    }
+    let ticks: HashMap<PathBuf, (String, String)> =
+        std::fs::read_to_string(store.join("ticks").join(&r.branch))
+            .unwrap_or_default()
+            .lines()
+            .filter_map(|l| {
+                let mut c = l.split('\t');
+                let (p, b, m) = (c.next()?, c.next()?, c.next()?);
+                Some((PathBuf::from(p), (b.to_string(), m.to_string())))
+            })
+            .collect();
+    if ticks.is_empty() {
+        return None;
+    }
+    let index = std::env::temp_dir().join(format!("merl-p823-{}", std::process::id()));
+    let run = |args: &[&str]| {
+        Command::new("git")
+            .arg("-C")
+            .arg(root)
+            .env("GIT_INDEX_FILE", &index)
+            .args(args)
+            .output()
+            .ok()
+            .filter(|o| o.status.success())
+            .map(|o| String::from_utf8_lossy(&o.stdout).trim().to_string())
+    };
+    run(&["read-tree", &r.merge_base])?;
+    let mut since = Since::default();
+    let set = |p: &str, blob: &str| {
+        run(&["update-index", "--add", "--cacheinfo", &format!("100644,{blob},{p}")])
+    };
+    for f in &r.files {
+        let Some(p) = f.path.to_str() else { continue };
+        if f.status == 'D' || f.untracked {
+            continue;
+        }
+        let now = git(&["hash-object", "-w", "--", p]).ok()?;
+        match ticks.get(&f.path) {
+            Some((blob, _)) if *blob == now => {
+                set(p, &now)?;
+            }
+            Some((blob, mb)) if *mb == r.merge_base => {
+                set(p, blob)?;
+                since.delta.push(f.path.clone());
+            }
+            Some((blob, mb)) => {
+                let tmp = std::env::temp_dir().join(format!("merl-p823-m{}", std::process::id()));
+                let _ = std::fs::create_dir_all(&tmp);
+                let show = |spec: String, name: &str| {
+                    let out = Command::new("git").arg("-C").arg(root).args(["cat-file", "-p", &spec]).output().ok()?;
+                    let path = tmp.join(name);
+                    std::fs::write(&path, out.stdout).ok()?;
+                    Some(path)
+                };
+                let ours = show(blob.clone(), "ours")?;
+                let old = show(format!("{mb}:{p}"), "old")?;
+                let new = show(format!("{}:{p}", r.merge_base), "new")?;
+                let merged = Command::new("git")
+                    .args(["merge-file", "-p"])
+                    .arg(&ours)
+                    .arg(&old)
+                    .arg(&new)
+                    .output()
+                    .ok()?;
+                if merged.status.success() {
+                    std::fs::write(tmp.join("merged"), &merged.stdout).ok()?;
+                    let b = git(&["hash-object", "-w", tmp.join("merged").to_str()?]).ok()?;
+                    set(p, &b)?;
+                    since.delta.push(f.path.clone());
+                } else {
+                    since.whole.push(f.path.clone());
+                }
+            }
+            None if mode == "B" => {
+                set(p, &now)?;
+                since.left_out += 1;
+            }
+            None => since.whole.push(f.path.clone()),
+        }
+    }
+    since.against = run(&["write-tree"])?;
+    let _ = std::fs::remove_file(&index);
+    since.short = "viewed".into();
+    Some(since)
 }
 
