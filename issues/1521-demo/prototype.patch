+        let seen: HashSet<String> = std::fs::read_to_string(self.p1521_seen_store())
+            .unwrap_or_default()
+            .lines()
+            .filter_map(|l| l.split_once('\t'))
+            .filter(|(p, _)| *p == key)
+            .map(|(_, h)| h.to_owned())
+            .collect();
+        self.p1521_answer_hashes(rel).iter().any(|h| !seen.contains(h))
     }
 
