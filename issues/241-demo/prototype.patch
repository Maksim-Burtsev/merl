     pub note: Option<String>,
+    pub since: Option<Since>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Since {
+    pub short: String,
+    pub against: String,
+    pub whole: Vec<PathBuf>,
+}
+
+fn proto_since(root: &Path, base: &str, r: &Review) -> Option<Since> {
+    let mode = std::env::var("MERL_P241").ok()?;
+    let git = |args: &[&str]| git(root, args);
+    let store = dirs(root)?.common_refs_dir.join("merl/reviewed").join(&r.branch);
+    let head = git(&["rev-parse", "HEAD"]).ok()?;
+    let old = std::fs::read_to_string(&store).ok().map(|s| s.trim().to_string());
+    let _ = std::fs::create_dir_all(store.parent()?);
+    let _ = std::fs::write(&store, &head);
+    if std::env::var("MERL_P241_ALL").is_ok() {
+        return None;
+    }
+    let old = old.filter(|o| *o != head)?;
+    git(&["cat-file", "-e", &format!("{old}^{{commit}}")]).ok()?;
+    let short = old[..7].to_string();
+    if mode == "B" {
+        return Some(Since { short, against: old, whole: vec![] });
+    }
+    let old_mb = git(&["merge-base", base, &old]).ok()?;
+    if old_mb == r.merge_base {
+        return Some(Since { short, against: old, whole: vec![] });
+    }
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(["merge-tree", "--write-tree", "--name-only", "--no-messages"])
+        .arg(format!("--merge-base={old_mb}"))
+        .args([&r.merge_base, &old])
+        .output()
+        .ok()?;
+    let text = String::from_utf8_lossy(&out.stdout).into_owned();
+    let mut lines = text.lines();
+    let tree = lines.next()?.to_string();
+    let whole: Vec<PathBuf> = lines.filter(|l| !l.is_empty()).map(PathBuf::from).collect();
+    if whole.is_empty() {
+        return Some(Since { short, against: tree, whole });
+    }
+    let index = std::env::temp_dir().join(format!("merl-p241-{}", std::process::id()));
+    let run = |args: &[&str]| {
+        Command::new("git")
+            .arg("-C")
+            .arg(root)
+            .env("GIT_INDEX_FILE", &index)
+            .args(args)
+            .output()
+            .ok()
+            .filter(|o| o.status.success())
+            .map(|o| String::from_utf8_lossy(&o.stdout).trim().to_string())
+    };
+    run(&["read-tree", &tree])?;
+    for p in &whole {
+        let p = p.to_str()?;
+        let entry = git(&["ls-tree", &r.merge_base, "--", p]).unwrap_or_default();
+        match entry.split_once('\t').map(|(m, _)| m.split(' ').collect::<Vec<_>>()) {
+            Some(m) if m.len() == 3 => {
+                run(&["update-index", "--add", "--cacheinfo", &format!("{},{},{p}", m[0], m[2])])?
+            }
+            _ => run(&["update-index", "--force-remove", p])?,
+        };
+    }
+    let against = run(&["write-tree"]);
+    let _ = std::fs::remove_file(&index);
+    Some(Since { short, against: against?, whole })
 }
 
