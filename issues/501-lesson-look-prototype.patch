+
+pub static CARD_SHOWN: std::sync::Mutex<String> = std::sync::Mutex::new(String::new());
+pub static CARD_SEEN: std::sync::Mutex<String> = std::sync::Mutex::new(String::new());
+
+pub fn card_seen() {
+    let shown = CARD_SHOWN.lock().map(|s| s.clone()).unwrap_or_default();
+    if let Ok(mut seen) = CARD_SEEN.lock() {
+        *seen = shown;
+    }
+}
+
+fn card_up(app: &App) -> bool {
+    std::env::var("MERL_P501").as_deref() == Ok("d")
+        && app.tutor.is_some()
+        && CARD_SHOWN.lock().map(|s| s.clone()).unwrap_or_default()
+            != CARD_SEEN.lock().map(|s| s.clone()).unwrap_or_default()
+}
