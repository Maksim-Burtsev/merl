+pub(super) fn proto() -> String {
+    std::env::var("MERL_399").unwrap_or_default()
+}
+
+fn proto_cut(name: &str, room: usize) -> String {
+    if wrap::width(name) <= room || room < 2 {
+        return name[wrap::cut(name, 0, room).0].to_string();
+    }
+    match proto().as_str() {
+        "a" | "b" | "c" => format!("{}\u{2026}", &name[wrap::cut(name, 0, room - 1).0]),
+        "" => name[wrap::cut(name, 0, room).0].to_string(),
+        _ => {
+            let total = wrap::width(name);
+            let tail = (room - 1) / 2 + (room - 1) % 2;
+            let head = room - 1 - tail;
+            let t = wrap::cut(name, total - tail, total).0;
+            format!("{}\u{2026}{}", &name[wrap::cut(name, 0, head).0], &name[t])
+        }
+    }
+}
