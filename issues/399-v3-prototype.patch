+fn proto_cut(name: &str, room: usize) -> String {
+    let total = wrap::width(name);
+    if total <= room || room < 2 {
+        return name[wrap::cut(name, 0, room).0].to_string();
+    }
+    match proto().contains('l') {
+        true => format!("\u{2026}{}", &name[wrap::cut(name, total - (room - 1), total).0]),
+        false => format!("{}\u{2026}", &name[wrap::cut(name, 0, room - 1).0]),
+    }
+}
