#!/usr/bin/env python3
import re
import subprocess
import sys
from pathlib import Path

HUNK = re.compile(
    r"<<<<<<< [^\n]*\n(.*?)(?:\|\|\|\|\|\|\| [^\n]*\n.*?)?=======\n(.*?)>>>>>>> [^\n]*\n",
    re.S,
)
COUNTER_LINE = re.compile(
    r"\s*(const (EXPECTS|LONG_FILES)\b.*|\(\"[^\"]+\", \d+\),?|\];)?\s*"
)
EXPECTS = re.compile(r"const EXPECTS: usize = \d+;")
LONG_FILES = re.compile(r"( *)const LONG_FILES: &\[\(&str, usize\)\] = &\[.*?\];", re.S)
TESTS = ["expects_do_not_grow", "no_source_file_grows_past_its_size"]


def counters_only(side):
    return all(COUNTER_LINE.fullmatch(line) for line in side.splitlines())


def take_ours(hunk):
    ours, theirs = hunk.group(1), hunk.group(2)
    return ours if counters_only(ours) and counters_only(theirs) else hunk.group(0)


def long_files(indent, files):
    head = f"{indent}const LONG_FILES: &[(&str, usize)] = &["
    rows = [f'("{name}", {n})' for name, n in files]
    one = head + ", ".join(rows) + "];"
    if len(one) <= 100:
        return one
    body = "".join(f"\n{indent}    {row}," for row in rows)
    return f"{head}{body}\n{indent}];"


def main():
    root = Path(
        subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    )
    path = root / "src/main.rs"
    conflicted = path.read_text()
    text = HUNK.sub(take_ours, conflicted)
    if "<<<<<<< " in text:
        sys.exit("recount: src/main.rs has a conflict beyond EXPECTS and LONG_FILES")
    zeroed = LONG_FILES.sub(lambda m: f"{m.group(1)}const LONG_FILES: &[(&str, usize)] = &[];", text)
    path.write_text(EXPECTS.sub("const EXPECTS: usize = 0;", zeroed))
    run = subprocess.run(
        ["tools/heavy", "cargo", "test", "--bin", "merl", "--", *TESTS],
        cwd=root,
        capture_output=True,
        text=True,
    )
    out = run.stdout + run.stderr
    if "test result:" not in out:
        path.write_text(conflicted)
        sys.exit(f"recount: the tests did not run, src/main.rs is left as it was\n{out[-3000:]}")
    expects = re.search(r"(\d+) lints silenced under src/", out)
    count = int(expects.group(1)) if expects else 0
    files = sorted(
        (name, int(n))
        for name, n in re.findall(r"^(\S+) has (\d+) lines, over \d+: split it", out, re.M)
    )
    measured = LONG_FILES.sub(lambda m: long_files(m.group(1), files), text)
    path.write_text(EXPECTS.sub(f"const EXPECTS: usize = {count};", measured))
    subprocess.run(["git", "add", "src/main.rs"], cwd=root, check=True)
    print(f"EXPECTS = {count}")
    print(f"LONG_FILES = {files}")


main()
