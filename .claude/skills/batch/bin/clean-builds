#!/bin/zsh
# Deletes the cargo build output a run leaves behind: every dir cargo made (CACHEDIR.TAG inside)
# under the run's folder and this session's /private/tmp folder. Ledger, task files, logs and
# reports stay; a dir a process still has open is left and named.
ledgers=($HOME/.cache/merl-batch/*/ledger.md(Nom))
run=${1:-${ledgers[1]:h}}
[[ -f $run/ledger.md ]] || { echo "usage: clean-builds [RUN_DIR]: no ledger.md in '$run'" >&2; exit 2; }
roots=($run /private/tmp/claude-$UID/*/${CLAUDE_CODE_SESSION_ID:-none}(N/))
open=$(lsof -n -Fn 2>/dev/null | sed -n 's/^n//p')
kb=0
for d in ${(u)${(f)"$(find $roots -type d \( -name target -o -name '*-target' -o -name 'target-*' \) -prune -print 2>/dev/null)"}}; do
  [[ -f $d/CACHEDIR.TAG ]] || continue
  if print -r -- $open | grep -qxF -- $d || print -r -- $open | grep -qF -- $d/; then
    print "in use, left: $d"
    continue
  fi
  size=$(du -sk $d | cut -f1)
  rm -rf -- $d && { (( kb += size )); print "$(( size / 1024 ))M $d"; }
done
print "freed $(( kb / 1024 ))M"
