# theme: T lists the themes and repaints the screen as the cursor moves over them; Esc puts the
# old theme back. Typing filters the list, Enter keeps the theme, and merl started again opens in
# it. The repaints are in the checkpoints' colours.
merl app/models.py
wait class OrderStatus(Enum):
key t T
wait tokyonight-night
key Down Down Down
wait Themes (
key Escape
wait app/models.py  1:1  [code]
key T
type rose-pine-moon
wait > rose-pine-moon
key Enter
wait theme rose-pine-moon saved
check grep -q rose-pine-moon "$HOME/.config/merl/config.toml"
merl app/models.py
wait class OrderStatus(Enum):
# --theme opens in the theme it names, whatever the config saved: T lists it (#310).
merl --theme github-light app/models.py
wait class OrderStatus(Enum):
key T
wait github-light
# The selected code and a picker's selected row take the theme's selection colour, made to show:
# srcery painted selected code in its own text colour (#556, #686).
key Escape
merl --theme srcery app/models.py
wait class OrderStatus(Enum):
key S-Down S-Down
wait app/models.py  3:1
key o
wait Files (
# merl's own themes without syntax colours are listed and open: seneca, seneca-light, lucerna (#775).
key Escape
merl --theme seneca app/models.py
wait class OrderStatus(Enum):
key T
type sene
wait seneca-light
key Escape
merl --theme lucerna app/models.py
wait class OrderStatus(Enum):
# A diff's added and removed lines carry the tint the theme gives them, behind the text, as LazyVim
# draws it; the cursor line's band yields to it and a selection paints over it (#845).
run git --git-dir=../origin.git show agent/refund > refund.patch
merl --theme tokyonight-moon refund.patch
wait +class RefundNotAllowed(Exception):
key Down Down Down Down Down Down Down Down Down Down Down S-Down
wait refund.patch  13:1
# merl draws the cursor itself, in the theme's Cursor colours, and hides the terminal's: a light
# theme's dark block reads in a dark terminal, over mosh too; typing, as in a picker's input, takes
# a second colour (#558).
merl --theme github-light app/models.py
wait class OrderStatus(Enum):
key T
wait github-light
