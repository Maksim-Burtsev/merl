# move: the cursor by word, row, paragraph, half screen and file, and the selection grown by
# char, row, word and line from it (#310). The status bar says where the cursor is after each.
merl app/service.py
wait class OrderService:
key t M-Right M-Right
wait app/service.py  1:9  [code]
key M-Left
wait app/service.py  1:6  [code]
key End
wait app/service.py  1:32  [code]
key Home
wait app/service.py  1:1  [code]
key } }
wait app/service.py  9:1  [code]
key {
wait app/service.py  6:1  [code]
key C-d
wait app/service.py  32:1  [code]
key C-u
wait app/service.py  6:1  [code]
key C-End
wait app/service.py  36:21  [code]
key C-Home
wait app/service.py  1:1  [code]
key :
type 13
key Enter M-Right
wait app/service.py  13:13  [code]
key v
wait app/service.py  13:13  [code]
key v
wait app/service.py  13:25  [code]
key Escape S-Left S-Left S-Right
wait app/service.py  13:24  [code]
key S-Up
wait app/service.py  12:24  [code]
key Escape M-S-Left
wait app/service.py  12:18  [code]
key Escape C-S-Left
wait app/service.py  12:1  [code]
key C-S-Right
wait app/service.py  12:78  [code]
# f folds the method the cursor is in into its first line, Down steps over the hidden body, f on
# the folded line unfolds it, and `:` to a hidden line opens its fold again (#598).
key Escape :
type 18
key Enter f
wait app/service.py  17:1  [code]
key Down
wait app/service.py  22:1  [code]
key Up f
wait app/service.py  17:1  [code]
key f :
type 20
key Enter
wait app/service.py  20:1  [code]
# f folds YAML, JSON, TOML, HTML, CSS and Markdown too (#627): on `worker:` in docker-compose.yml it
# folds the service and Down steps over it to `db:`; on README.md's heading it folds the section.
key o
type compose
key Enter
wait docker-compose.yml  1:1  [code]
key :
type 9
key Enter f
wait docker-compose.yml  9:1  [code]
key Down
wait docker-compose.yml  15:1  [code]
key o
type READMEmd
key Enter f
wait README.md  1:1  [code]
# A fourth `v` selects the whole file, the cursor at its end (#635).
key o
type appservice
key Enter :
type 13
key Enter M-Right v v v
wait app/service.py  15:33  [code]
key v
wait app/service.py  36:21  [code]
# Shift extends End, PgDn, Home, Ctrl+Home, PgUp and Ctrl+End as it does an arrow: the selection
# grows over all the cursor passes, from where it started (#687).
key Escape o
type appservice
key Enter :
type 13
key Enter S-Down S-Down
wait app/service.py  15:1  [code]
key S-End
wait app/service.py  15:33  [code]
key S-NPage
wait app/service.py  36:21  [code]
key S-Home
wait app/service.py  36:1  [code]
key C-S-Home
wait app/service.py  1:1  [code]
key Escape :
type 20
key Enter End S-PPage
wait app/service.py  1:32  [code]
key Escape C-S-End
wait app/service.py  36:21  [code]
