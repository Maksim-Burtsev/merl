# csharp-d: d on C# names bound in their own method (#345). A lambda's parameter and a method's
# parameter land on their binding, `local`, and the namesake local of another method is not
# offered. The C# file is written here, so no other scenario's tree or search sees it.
merl
wait Open a file (fuzzy)
run mkdir -p billing && printf '%s\n' 'namespace Orders.Billing;' '' 'public static class Refunds' '{' '    public static void Register(IServiceCollection services, string callbackUrl)' '    {' '        services.AddAuthentication(options =>' '        {' '            options.RedirectUri = callbackUrl;' '        });' '    }' '}' '' 'public class Audit' '{' '    public void Load()' '    {' '        var options = new JsonSerializerOptions();' '    }' '}' > billing/Refunds.cs
wait billing
key o
type billing/Refunds.cs
key Enter
wait public static class Refunds
key /
type options.Redirect
key Enter d
wait options → Refunds.Register.options (local)
key /
type callbackUrl;
key Enter d
wait callbackUrl → Refunds.Register.callbackUrl (local)
# #352: a member of a typed receiver lands in its type, not on a namesake, and a member of a
# type the project does not declare has no definition in it.
run printf '%s\n' 'public class Mailer' '{' '    public void Send(string to) { }' '}' '' 'public class Fax' '{' '    public void Send(string to) { }' '    public void AppendLine(int n) { }' '}' '' 'public class Outbox' '{' '    public void Flush()' '    {' '        var mailer = new Mailer();' '        mailer.Send("ops");' '        var sb = new StringBuilder();' '        sb.AppendLine("sent");' '    }' '}' > billing/Outbox.cs
wait Outbox.cs
key o
type billing/Outbox.cs
key Enter
wait public class Outbox
key /
type Send("
key Enter d
wait Send → Mailer.Send (via mailer: Mailer)
key /
type AppendLine("
key Enter d
wait no definition for AppendLine in the project (via sb: StringBuilder)
# #360: a bare name is its class's own first, then a base's, never another class's namesake. #349:
# a type is looked for in the file's own project, not in a project its `.csproj` does not reference.
run mkdir -p shop.app shop.api && printf '%s\n' '<Project Sdk="Microsoft.NET.Sdk"></Project>' > shop.app/Shop.App.csproj && cp shop.app/Shop.App.csproj shop.api/Shop.Api.csproj && printf '%s\n' 'namespace Shop.Api;' 'public class Address { }' > shop.api/Address.cs && printf '%s\n' 'namespace Shop.App;' 'public class Address { }' > shop.app/Address.cs && printf '%s\n' 'namespace Shop.App;' '' 'public class ViewModelBase' '{' '    protected void IsBusyFor(int n) { }' '}' '' 'public class Page : ViewModelBase' '{' '    public Address Home()' '    {' '        IsBusyFor(1);' '        return new Address();' '    }' '}' '' 'public class Spinner' '{' '    public void IsBusyFor(int n) { }' '}' > shop.app/Page.cs
wait shop.app
key o
type shop.app/Page.cs
key Enter
wait public class Page
key /
type IsBusyFor(1
key Enter d
wait IsBusyFor → ViewModelBase.IsBusyFor (via Page)
key /
type Address(
key Enter d
wait Address: by name, 1 match
