# gdscript-d: d in GDScript (#434). A call through an autoload lands on its function in the
# script project.godot autoloads, and a local stays in its function. The files are written here,
# not in the project, which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p godotshop/globals godotshop/actors && printf '[autoload]\nGameState="*res://globals/game_state.gd"\n' > godotshop/project.godot && printf 'extends Node\n\nvar coins := 0\n\nfunc add_coins(amount: int) -> void:\n\tcoins += amount\n' > godotshop/globals/game_state.gd && printf 'class_name Player\nextends CharacterBody2D\n\nfunc pick_up(value: int) -> void:\n\tvar direction := value\n\tGameState.add_coins(direction)\n' > godotshop/actors/player.gd
key q
wait merl exited: 0
merl godotshop/actors/player.gd
wait class_name Player
key /
type add_coins
key Enter d
wait add_coins: via GameState
merl godotshop/actors/player.gd
wait class_name Player
key /
type direction)
key Enter d
wait pick_up.direction (local)
key Escape
