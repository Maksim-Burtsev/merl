# cmake-d: d in CMake (#432). A call of a helper function lands on its `function(` in the
# `.cmake` module the project includes, and the `include(` names that module. The files are
# written here, not in the project, which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p cmakeshop/cmake && printf 'function(shop_add_library name)\n  add_library(${name} STATIC ${ARGN})\nendfunction()\n' > cmakeshop/cmake/ShopHelpers.cmake && printf 'project(shop CXX)\ninclude(ShopHelpers)\n\nshop_add_library(shop_core src/order.cpp)\n' > cmakeshop/CMakeLists.txt
key q
wait merl exited: 0
merl cmakeshop/CMakeLists.txt
wait project(shop CXX)
key /
type shop_add_library
key Enter d
wait shop_add_library: by name, 1 match
merl cmakeshop/CMakeLists.txt
wait project(shop CXX)
key /
type ShopHelpers
key Enter d
wait ShopHelpers: module
key Escape
