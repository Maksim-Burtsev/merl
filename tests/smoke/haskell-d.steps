# haskell-d: d in Haskell (#426). A function a module imports lands on its signature in the module
# it names, and a `go` its `where` binds is local. The files are written here, not in the project,
# which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p hsshop/src/Shop && printf 'module Shop.Money (Money (..), formatPrice) where\n\nnewtype Money = Money { cents :: Int }\n\nformatPrice :: Money -> String\nformatPrice (Money c) = show c\n' > hsshop/src/Shop/Money.hs && printf 'module Shop.Cart where\n\nimport Shop.Money (Money (..), formatPrice)\n\nlabel :: Money -> String\nlabel m = go (formatPrice m)\n  where\n    go s = "Total: " ++ s\n' > hsshop/src/Shop/Cart.hs
key q
wait merl exited: 0
merl hsshop/src/Shop/Cart.hs
wait label m = go
key /
type (formatPrice
key Enter Right d
wait formatPrice: via import
merl hsshop/src/Shop/Cart.hs
wait label m = go
key /
type go (
key Enter d
wait go: local
key Escape
