# ruby-d: d in Ruby (#365). A call with no receiver lands on the method of the class it is made
# in, before a namesake of another class; a parameter lands on its `def`, where it was a picker of
# every method's local of that name. The file is written here, so the project keeps its files.
merl README.md
wait README.md  1:1
run mkdir -p app/ruby && printf '%s\n' 'class SessionsController' '  def on_success(user)' '    track(user)' '  end' '' '  def track(user)' '    user' '  end' 'end' '' 'class AdminController' '  def show' '    user = User.find(1)' '    track(user)' '  end' '' '  def track(user)' '    nil' '  end' 'end' > app/ruby/sessions.rb
merl app/ruby/sessions.rb
wait class SessionsController
key t /
type track(
key Enter d
wait track → SessionsController.track (via SessionsController)
key [ /
type user)
key Enter d
wait (local)
# A Rails `scope` is a class method of its model (#374): `Account.recent` lands on it.
run printf '%s\n' 'class Feed' '  def call' '    Account.recent' '  end' 'end' '' 'class Account < ApplicationRecord' '  scope :recent, -> { all }' 'end' > app/ruby/feed.rb
merl app/ruby/feed.rb
wait class Feed
key t /
type recent
key Enter d
wait recent → Account.recent
# A bare call no project declaration answers lands in the gem `Gemfile.lock` names, at its locked
# version, read-only, where it said `no definition for throttle` (#369). The gem is installed
# beside the project, in the `BUNDLE_PATH` its `.bundle/config` names.
run mkdir -p ../bundle/ruby/3.3.0/gems/rack-attack-6.7.0/lib/rack .bundle && printf '%s\n' 'module Rack' '  class Attack' '    def self.throttle(name, options)' '    end' '  end' 'end' > ../bundle/ruby/3.3.0/gems/rack-attack-6.7.0/lib/rack/attack.rb && printf '%s\n' '---' 'BUNDLE_PATH: "../bundle"' > .bundle/config && printf '%s\n' 'GEM' '  specs:' '    rack-attack (6.7.0)' > Gemfile.lock
run printf '%s\n' 'class Rack::Attack' "  throttle('logins/ip', limit: 5)" 'end' > app/ruby/attack.rb
merl app/ruby/attack.rb
wait class Rack::Attack
key t /
type throttle
key Enter d
wait read-only
# f on a line a word opens folds that block, not the method around it: Ruby's `if` to its `end`,
# shell's `if` to its `fi`, each shown after the `⋯` (#626).
run printf '%s\n' 'class Checkout' '  def call(user)' '    if user.admin?' '      grant(user)' '    end' '    charge(user)' '  end' 'end' > app/ruby/checkout.rb
merl app/ruby/checkout.rb
wait class Checkout
key :
type 3
key Enter f
wait admin?  ⋯ end
run printf '%s\n' 'deploy() {' '  if [ -n "$1" ]; then' '    echo "$1"' '  fi' '}' > scripts/deploy.sh
merl scripts/deploy.sh
wait deploy() {
key :
type 2
key Enter f
wait then  ⋯ fi
