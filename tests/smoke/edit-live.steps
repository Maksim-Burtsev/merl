# edit-live: editing a file an agent rewrites. The agent's write reloads the open file with the
# cursor and the scroll kept, and Ctrl+Z takes the write back (#122). Typing not yet saved under
# a write on disk: the status line says so; Ctrl+S keeps yours, and the next time Ctrl+R takes
# the disk's. The agent deletes a file you have unsaved typing in: merl does not write it back,
# even on Esc (#119); Ctrl+R drops the typing, and [ / ] walk the history past it (#118).
merl app/service.py
wait class OrderService:
key t :
type 30
key Enter C-d
wait app/service.py  36:1
run perl -pi -e 's/\Qis {order.status.value}\E/cannot be cancelled: {order.status.value}/' app/service.py
wait app/service.py  36:1  [code]  reloaded
key C-z
wait raise ValueError(f"order {order_id} is {order.status.value}")
key C-s
wait 32             raise ValueError(f"order {order_id} is
key /
type return order
key Enter End Enter Enter
type # paid orders go to the worker
run perl -pi -e 's/\QOrderNotFound(Exception)\E/OrderNotFound(LookupError)/' app/service.py
wait changed on disk: Ctrl+S overwrites, Ctrl+R reloads
key C-s
wait app/service.py  37:39  [edit]
run grep -q 'paid orders go to the worker' app/service.py && ! grep -q LookupError app/service.py
type  soon
run perl -pi -e 's/\QOrderNotFound(Exception)\E/OrderNotFound(LookupError)/' app/service.py
wait changed on disk: Ctrl+S overwrites, Ctrl+R reloads
key C-r
wait reloaded
run grep -q LookupError app/service.py && ! grep -q 'worker soon' app/service.py
key Escape o
type uow
key Enter
wait app/uow.py  1:1
key C-End Enter Enter
type # unused since the service took over
run git rm -q app/uow.py
wait app/uow.py gone
key Escape
wait app/uow.py ●  21:45  [code]
run test ! -e app/uow.py
key C-r
wait app/uow.py  21:45  [code]  app/uow.py gone
key [
wait app/uow.py  1:1  [code]
key [
wait app/service.py  37:39  [code]
key ]
wait app/service.py  37:39  [code]  app/uow.py gone
run test ! -e app/uow.py
# The tree marks the file the agent changed `M` and the one it added `A`, as git sees them, and
# a file written while merl runs gets its mark after the walk (#402).
run printf 'def notify(order):\n    return order\n' > app/notify.py
key t
wait A notify.py
# The agent commits: HEAD moves and nothing in the project is written, and the letters go (#402).
run git add -A && git commit -qm "orders: notify"
wait │    notify.py
# The gutter compares the file with HEAD, as the tree's letters do: a file the agent created is
# green on every line, and a change it staged keeps its bars (#749).
run printf 'def audit(order):\n    return order.id\n' > app/audit.py
wait A audit.py
key Escape o
type audit
key Enter
wait ▎def audit(order):
run perl -pi -e 's/"refunded"/"refund"/' app/models.py && git add app/models.py
wait M models.py
key Escape o
type app/models
key Enter
wait ▎    REFUNDED = "refund"
