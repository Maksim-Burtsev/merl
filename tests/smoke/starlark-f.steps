# starlark-f: f folds Starlark (#1349). On a def's first line f folds the def and f there unfolds
# it; on a line that opens a multi-line call f folds the call. The file is written here, not in
# the project, which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p bzl && printf 'def shop(name):\n    native.genrule(\n        name = name,\n        outs = ["a"],\n    )\n' > bzl/defs.bzl
key q
wait merl exited: 0
merl bzl/defs.bzl
wait A defs.bzl
key f
wait 4 lines
key f
wait outs = 
key :
type 2
key Enter f
wait 2 lines ⋯ )
key q
wait merl exited: 0
# A def whose parameters wrap: f on the def line and f in its body fold the whole def (#1359).
run printf 'def shop_library(\n        name,\n        srcs = []):\n    native.filegroup(name = name, srcs = srcs)\n    print(name)\n' > bzl/lib.bzl
merl bzl/lib.bzl
wait A lib.bzl
key f
wait 4 lines ⋯
key f
wait print(name)
key :
type 5
key Enter f
wait 4 lines ⋯
key q
wait merl exited: 0
