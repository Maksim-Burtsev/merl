# nix-d: d in Nix (#430). A function the host calls through its `lib` lands on its binding in
# lib/default.nix, and a parameter of the file's header is local. The files are written here, not
# in the project, which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p nixshop/lib nixshop/hosts && printf '{ lib }:\n{\n  mkService = { name, port ? 8080 }: {\n    inherit name port;\n  };\n}\n' > nixshop/lib/default.nix && printf '{ config, pkgs, lib, ... }:\nlet\n  shopLib = import ../lib { inherit lib; };\n  api = shopLib.mkService { name = "api"; };\nin\n{\n  environment.systemPackages = [ pkgs.hello ];\n}\n' > nixshop/hosts/web.nix
key q
wait merl exited: 0
merl nixshop/hosts/web.nix
wait shopLib = import
key /
type mkService
key Enter d
wait mkService: by name, 1 match
merl nixshop/hosts/web.nix
wait shopLib = import
key /
type pkgs.hello
key Enter d
wait pkgs: local
key Escape
