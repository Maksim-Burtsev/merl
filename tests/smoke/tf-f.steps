# tf-f: f folds Terraform (#1353). On a block's first line f folds the block to its closing brace
# and f there unfolds it; inside an object f folds that object. The file is written here, not in
# the project, which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p infra && printf 'resource "aws_s3_bucket" "logs" {\n  bucket = "logs"\n\n  tags = {\n    Name = "logs"\n    Team = "infra"\n  }\n}\n' > infra/main.tf
key q
wait merl exited: 0
merl infra/main.tf
wait A main.tf
key f
wait 7 lines
key f :
type 5
key Enter f
wait infra/main.tf  4:1
key q
wait merl exited: 0
