# ml-d: d in OCaml and F# (#427). A call qualified by a module lands in that module's file, and an
# F# function the file opens is found by name. The files are written here, not in the project,
# which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p mlshop/lib mlshop/src && printf 'type t = { cents : int }\n\nlet format_price { cents } = string_of_int cents\n' > mlshop/lib/money.ml && printf 'let label m =\n  let prefix = "Total: " in\n  prefix ^ Money.format_price m\n' > mlshop/lib/cart.ml && printf 'module Shop.Money\n\ntype Money = { Cents: int }\n\nlet formatPrice (m: Money) = string m.Cents\n' > mlshop/src/Money.fs && printf 'module Shop.Cart\n\nopen Shop.Money\n\nlet label m =\n    let prefix = "Total: "\n    prefix + formatPrice m\n' > mlshop/src/Cart.fs
key q
wait merl exited: 0
merl mlshop/lib/cart.ml
wait let label m
key /
type format_price
key Enter d
wait format_price: via Money
merl mlshop/src/Cart.fs
wait module Shop.Cart
key /
type formatPrice
key Enter d
wait formatPrice: by name, 1 match
key Escape
