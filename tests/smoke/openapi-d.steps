# openapi-d: d follows a $ref in OpenAPI (#435). A reference into another file lands on the key its
# pointer names there. The files are written here, not in the project, which every other scenario
# counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p api/schemas && printf 'Order:\n  type: object\n  properties:\n    id:\n      type: string\n' > api/schemas/order.yaml && printf "openapi: 3.1.0\npaths:\n  /orders:\n    get:\n      responses:\n        \"200\":\n          content:\n            application/json:\n              schema:\n                \$ref: './schemas/order.yaml#/Order'\n" > api/openapi.yaml
key q
wait merl exited: 0
merl api/openapi.yaml
wait openapi: 3.1.0
key /
type Order'
key Enter d
wait Order: via
key Escape
