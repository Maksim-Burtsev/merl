# odd-files: the files that tripped merl before. Rows with emoji and Cyrillic keep every letter,
# the cursor lands on the word after an emoji (#185), and after a scroll too (#206). A 1 MB JSON
# on one line opens at once (#184), timed. A CSV that Excel wrote, with a BOM and CRLF: an edit
# at 1:1 keeps the BOM (#177) and every line end stays CRLF. A PNG is not shown as text.
# `merl FILE:LINE:COL`, as a traceback prints it, opens there (#161); `merl FILE` outside a
# repository opens the file without walking its directory (#182).
merl docs/notes.md
wait # Release notes for the support team
key t /
type manager
key Enter
wait docs/notes.md  5:46
key PageDown
wait - ✔️ Cancelled orders show the reason the customer gave, under the total.
key PageUp
wait - ⚠️ A refund past the 30-day window needs a manager's approval: open the order, press Refund
key o
type orders.min
key Enter
time
wait [{"id":1,"customer_id":1327,"total":"853.34"
key o
type refunds-2026
key Enter
wait 1 order_id;amount;reason
key Enter Delete*6 Escape
wait 1▎id;amount;reason
run python3 -c "d = open('data/refunds-2026-08.csv', 'rb').read(); assert d.startswith(b'\xef\xbb\xbfid;amount;reason\r\n') and d.count(b'\n') == d.count(b'\r\n') == 3, d"
key o
type architecture
key Enter
wait binary file
merl app/service.py:35:29
wait app/service.py  35:29
merl ../home/.zshrc
wait alias gs="git status"
# A line longer than merl draws, the JSON's, ends in a dim `…` after its last drawn char, wrapped
# at Ctrl+End and not wrapped at End (#283).
merl data/orders.min.json
wait [{"id":1,"customer_id":1327,"total":"853.34"
key C-End
wait {"i…
key w End
# The `1` and the `‹` in the gutter colour, at 3:1 on the background in its shot (#555).
wait 1 ‹
# A binary file is an empty pane with one centred, dimmed note, no line number, no cursor (#287).
key o
type architecture
key Enter
wait binary file, not shown
# A script an agent wrote with the hidden chars of a "Trojan Source" attack: each is drawn as its
# code on a warning's amber, the cursor steps over one in a press, and Delete takes it out (#401).
# The script is written and committed here, not by setup.sh, so the other scenarios' file lists stay as they are.
run printf 'def is_admin(user):\n    access_level = "user\342\200\256 \342\201\246// Check if admin\342\201\251 \342\201\246"\n    if access_level != "user\342\200\256 \342\201\246// Check if admin\342\201\251 \342\201\246":\n        return True\n    token = "abc\342\200\213def"\n    return False\n' > scripts/grant_admin.py && git add scripts/grant_admin.py && git commit -qm "scripts: grant_admin"
merl scripts/grant_admin.py:5:17
wait def is_admin(user):
wait access_level = "user<202e> <2066>// Check if admin<2069> <2066>"
key Right
wait scripts/grant_admin.py  5:23
key Left Enter Delete Escape
wait 5▎    token = "abcdef"
run python3 -c "d = open('scripts/grant_admin.py').read(); assert 'token = \"abcdef\"' in d and '‮' in d, d"
# `d` on a Markdown link opens the file at the heading it names (#421).
merl docs/notes.md
wait # Release notes for the support team
key /
type README
key Enter
key d
wait link README.md#orders
