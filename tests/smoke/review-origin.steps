# review-origin: the branch named as `git branch -a` or a merge request shows it.
# `merl -r origin/agent/refund` reviews agent/refund as `--review=agent/refund` does: fetched from
# the local origin, opened on its first hunk (#271).
merl -r origin/agent/refund
wait hunk 1/1  file 1/8

# A branch checked out nowhere opens in a folder of its own: a key that edits code says
# read-only, and your checkout stays on main (#215).
key Enter
wait read-only: a pushed branch
check test "$(git symbolic-ref --short HEAD)" = main
