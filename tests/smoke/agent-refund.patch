diff --git a/tests/test_refunds.py b/tests/test_refunds.py
new file mode 100644
index 0000000..3bdaad3
--- /dev/null
+++ b/tests/test_refunds.py
@@ -0,0 +1,23 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+import pytest
+
+from app.models import Order, OrderStatus
+from app.refunds import RefundNotAllowed, refund_amount
+
+NOW = datetime(2026, 9, 1, tzinfo=timezone.utc)
+
+
+def paid(days_ago):
+    return Order(id=1, customer_id=7, total=Decimal("40.00"), status=OrderStatus.PAID,
+                 created_at=NOW - timedelta(days=days_ago))
+
+
+def test_whole_total_inside_the_window():
+    assert refund_amount(paid(3), window_days=30, now=NOW) == Decimal("40.00")
+
+
+def test_nothing_after_the_window():
+    with pytest.raises(RefundNotAllowed):
+        refund_amount(paid(31), window_days=30, now=NOW)
