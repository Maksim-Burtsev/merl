--- /dev/null
+++ b/app/refunds.py
@@ -0,0 +1,18 @@
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+from app.models import Order, OrderStatus
+
+
+class RefundNotAllowed(Exception):
+    pass
+
+
+def refund_amount(order: Order, window_days: int, now: datetime | None = None) -> Decimal:
+    """What to give back: the whole total inside the window, nothing after it."""
+    now = now or datetime.now(timezone.utc)
+    if order.status is not OrderStatus.PAID:
+        raise RefundNotAllowed(f"order {order.id} is {order.status.value}")
+    if now - order.created_at > timedelta(days=window_days):
+        raise RefundNotAllowed(f"order {order.id} is past the {window_days}-day window")
+    return order.total
