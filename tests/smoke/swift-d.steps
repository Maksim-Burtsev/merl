# swift-d: d on a name a Swift `for` binds lands on the loop, `(local)`, where it searched the
# project by name and jumped to a property of an unrelated struct (#366). The file is written
# here, not in the project, which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p ios && printf 'struct Stats {\n    let attempt: Int\n}\n\nfunc retry(times: Int) {\n    for attempt in 0..<times {\n        print(attempt)\n    }\n}\n' > ios/Retry.swift
key q
wait merl exited: 0
merl ios/Retry.swift
wait func retry(
key t /
type attempt)
key Enter d
wait (local)
# A bare name in an `extension` body is the protocol's member through `self`, where it offered
# every declaration of the name in the project (#380).
run printf 'protocol Lock {\n    func lock()\n}\n\nextension Lock {\n    func around() {\n        lock() // held\n    }\n}\n\nfinal class UnfairLock {\n    private let lock = 0\n}\n' > ios/Protected.swift
merl ios/Protected.swift
wait extension Lock
key t /
type lock() //
key Enter d
wait via self: Lock
# A member on a value whose type its declaration writes lands on that type's member, where it
# offered every member of the name in the project (#384).
run printf 'struct Instant {\n    let value: Double\n\n    static func - (lhs: Instant, rhs: Instant) -> Double {\n        lhs.value - rhs.value\n    }\n}\n\nstruct Clock {\n    let value: Int\n}\n' > ios/Instant.swift
merl ios/Instant.swift
wait struct Clock
key t /
type value - rhs
key Enter d
wait value → Instant.value
