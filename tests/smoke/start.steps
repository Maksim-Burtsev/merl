# start: the other ways merl starts, each on an empty HOME. --tutor opens on its first lesson,
# --drill 3 on its first task, and --keys prints the table of keys and exits 0.
merl --tutor
wait Tutor 1/
merl --drill 3
wait Drill 1/3
merl --keys
wait merl exited: 0
# plain `merl` with no file to open: the start screen, its status bar with no cursor position,
# only the project and the pane (#285)
merl
wait Open a file (fuzzy)
# #261: at 80x24 the tutor's lesson 3 wraps to three rows, and the panel grows to them: the key
# it asks for, on the third row, is drawn
size 80x24
merl --tutor
wait Tutor 1/
key o
type store
key Enter
wait Tutor 2/
key /
type load_config
key Enter
wait Tutor 3/
wait the call inside NoteStore.
