# start: the other ways merl starts, each on an empty HOME. --tutor opens on its first lesson,
# --drill 3 on its first task, and --keys prints the table of keys and exits 0.
merl --tutor
wait Tutor 1/
merl --drill 3
wait Drill 1/3
merl --keys
wait merl exited: 0
# plain `merl` with no file to open: the start screen, its status bar with no cursor position
# (#285), no project and no pane, only the clock (#302); a message, `[` here, starts at the left
# edge (#302)
merl
wait Open a file (fuzzy)
key [
wait start of history
# --help prints the flags and exits 0 (#310).
merl --help
wait merl exited: 0
# #261: at 80x24 the tutor's lesson 3 wraps to three rows, and the panel grows to them: the key
# it asks for, on the third row, is drawn
size 80x24
merl --tutor
wait Tutor 1/
key o
type store
key Enter
wait Tutor 2/
key /
type load_config
key Enter
wait Tutor 3/
wait the call inside NoteStore.
# #761, #857: the status bar ends with the clock, no `? help` before it; the runner fixes the time
# at 14:32 UTC. A `:` prompt takes the right edge, and the clock is back after Enter.
merl app/config.py
wait 14:32
key :
type 10
wait :10
key Enter
wait 14:32
# #761: `clock` in config.toml sets the format, 12 hours here.
run mkdir -p "$HOME/.config/merl" && printf 'clock = "%%I:%%M %%p"\n' >> "$HOME/.config/merl/config.toml"
merl app/config.py
wait 02:32 PM
