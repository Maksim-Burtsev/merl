# review-notes: notes for the agent (#768), on in a review without a setting (#836). On
# agent/refund, a types a note in place under the line, Esc keeps it, and the file in the git dir
# holds it; Enter on the note edits it, Enter there starts a second line; Ctrl+X cuts it whole and
# the file goes, Ctrl+Z brings it back. c onto the lines repos.py deleted: they take a note too,
# quoted with `-`. The agent deletes the file while merl is open: the notes go. A file read
# without a review takes no note: a does nothing
merl --review=agent/refund
wait app/refunds.py  1:1  [code]  hunk 1/1
key a
wait [edit]
type check the window
key Escape
wait app/refunds.py  1:1  [code]
check grep -qx 'check the window' "$(git rev-parse --git-common-dir)/merl/notes/agent/refund"
key Enter End Enter
type and the clock
wait and the clock
key Escape
wait app/refunds.py  1:1  [code]
check tail -2 "$(git rev-parse --git-common-dir)/merl/notes/agent/refund" | grep -qx 'and the clock'
key Enter C-x C-x
check ! test -e "$(git rev-parse --git-common-dir)/merl/notes/agent/refund"
key Escape C-z
wait and the clock
key c
wait app/repos.py  -32:1  [code]  hunk 1/1
key a
type why delete these
wait why delete these
key Escape
wait app/repos.py  -32:1  [code]
check grep -qx -- '- .*' "$(git rev-parse --git-common-dir)/merl/notes/agent/refund"
run rm "$(git rev-parse --git-common-dir)/merl/notes/agent/refund"
key Down
check ! $SMOKE_TMUX capture-pane -p -t 0 | grep -q 'why delete these'
merl app/models.py
wait app/models.py  1:1
key a
sleep 0.3
check ! $SMOKE_TMUX capture-pane -p -t 0 | grep -q '\[edit\]'
wait app/models.py  1:1  [code]
# Threads with the agent (#1307). Round 1 walks on from repos.py, which ticks it beside refunds.py. Round 2:
# the agent answered two notes in the notes file, left one whose line it changed and one on a file
# it deleted, and opened a thread of its own. The review opens on refunds.py, unticked by the
# answer there, under the thread on the deleted file; c stops at the answer, Enter answers it once
# and Enter again edits that answer. c skips repos.py, ticked and untouched, for service.py, where
# the thread whose line changed waits above the file and the agent's own thread on its line
merl --review=agent/refund
wait hunk 1/1  viewed 1/7
key c
wait viewed 2/7
run printf '# merl notes\n\napp/refund_rules.py:3\n> WINDOW_DAYS = 30\ndrop this file, the window is in Settings\nagent: deleted it; refunds.py reads settings.refund_window_days\n\napp/refunds.py:18\n>     return order.total\nwhy the whole total?\nagent: a partial refund needs the provider API; the whole order until then\n\napp/service.py:5\n> from app.refunds import refund_amount_v1\nname it refund_amount\nagent: renamed, and nothing else imported it\n\napp/service.py:44\n>         order.status = OrderStatus.REFUNDED\nagent: set it once the provider confirms, not before?\n' > "$(git rev-parse --git-common-dir)/merl/notes/agent/refund"
merl --review=agent/refund
wait app/refund_rules.py, file deleted
key c
wait app/refunds.py  1:1
key c
wait app/refunds.py  18:1
key Enter
type then a ticket for it
wait you    then a ticket for it
key Escape
wait app/refunds.py  18:1  [code]
check grep -A1 '^agent: a partial refund' "$(git rev-parse --git-common-dir)/merl/notes/agent/refund" | grep -qx 'user: then a ticket for it'
key Enter End
type , linked here
wait then a ticket for it, linked here
key Escape
wait app/refunds.py  18:1  [code]
check grep -c '^user:' "$(git rev-parse --git-common-dir)/merl/notes/agent/refund" | grep -qx 1
key c
wait line 5, changed
key c c c c
wait agent  set it once the provider confirms
# A note stays on its own line (#1543). A note on cancel's `return order`, one of three alike
# lines; the agent then changes that line and adds two imports above it, while merl is open: the
# note goes dim with (changed) under the deleted copy of its line, not live under an alike one
run printf '# merl notes\n\napp/service.py:40\n>         return order\nkeep this one\n' > "$(git rev-parse --git-common-dir)/merl/notes/agent/refund"
merl --review=agent/refund app/service.py:40
wait keep this one
run d=.git/merl/branches/agent/refund/orders; [ -d $d ] || d=.; f=$d/app/service.py; { printf 'import logging\nimport os\n'; sed '40s/return order/return self.get(order_id)/' $f; } > $f.new && mv $f.new $f
# the tree's counts after the edit come from a thread, after the note's (changed) (#1036)
wait 8 files · +62 −40 · 1 note
# A note finds its own line after a reopen by the version of the file it was written on (#1594).
# A note on mark_paid's `return order`, line 33, seven lines below get's alike one, on the agent's
# uncommitted edits; with merl closed, the agent adds seven lines above get and commits, so get's
# line comes to 33: the reopened note is live under mark_paid's, now line 40, not under get's
key q
wait merl exited: 0
run rm "$(git rev-parse --git-common-dir)/merl/notes/agent/refund"
merl --review=agent/refund app/service.py:33
wait 8 files · +62 −40
key a
type callers read its status
key Escape
wait app/service.py  33:1  [code]
check grep -qx 'app/service.py:33' "$(git rev-parse --git-common-dir)/merl/notes/agent/refund"
key q
wait merl exited: 0
run d=.git/merl/branches/agent/refund/orders; [ -d $d ] || d=.; f=$d/app/service.py; { sed -n '1,15p' $f; printf 'class RefundFailed(Exception):\n    """The provider refused the refund."""\n\n    def __init__(self, order_id: int, reason: str):\n        super().__init__(f"order {order_id}: {reason}")\n\n\n'; sed '1,15d' $f; } > $f.new && mv $f.new $f && git -C $d commit -qam 'service: a RefundFailed error'
merl --review=agent/refund app/service.py:44
wait callers read its status
# A changed two-line note names the lines it was written on (#1604). A note on cancel's `if` and
# its `raise`, lines 44 to 45; with merl closed, the agent changes the `raise` and commits: the
# reopened note sits dim under the deleted `raise`, labelled lines 44 to 45, not 44 to -32
key S-Down S-End a
type a 409, not a ValueError
key Escape
wait app/service.py  45:74  [code]
check grep -qx 'app/service.py:44-45' "$(git rev-parse --git-common-dir)/merl/notes/agent/refund"
key q
wait merl exited: 0
run d=.git/merl/branches/agent/refund/orders; [ -d $d ] || d=.; f=$d/app/service.py; sed '45s/is {order.status.value}/cannot be cancelled/' $f > $f.new && mv $f.new $f && git -C $d commit -qam 'service: say why an order cannot be cancelled'
merl --review=agent/refund app/service.py:44
wait a 409, not a ValueError
