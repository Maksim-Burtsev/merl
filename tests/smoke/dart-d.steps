# dart-d: d in Dart (#414). A name a plain import brings in lands by name; a name behind the
# prefix of `import … as c` is the one of the file that import names. The files are written
# here, not in the project, which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p shop/lib && printf 'name: shop\n' > shop/pubspec.yaml && printf 'String formatPrice(int cents) => cents.toString();\n' > shop/lib/money.dart && printf 'double discount(double total) => total * 0.9;\n' > shop/lib/coupon.dart && printf "import 'money.dart';\nimport 'coupon.dart' as c;\n\nclass Cart {\n  int total = 0;\n  String label() => formatPrice(total);\n  double cut() => c.discount(1.0);\n  double discount(double x) => x;\n}\n" > shop/lib/cart.dart
key q
wait merl exited: 0
merl shop/lib/cart.dart
wait class Cart
key /
type formatPrice
key Enter d
wait formatPrice: by name, 1 match
merl shop/lib/cart.dart
wait class Cart
key /
type c.discount
key Enter
key Right*2 d
wait via import coupon.dart
key Escape
