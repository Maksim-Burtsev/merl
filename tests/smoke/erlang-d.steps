# erlang-d: d in Erlang (#425). Elixir's call into an Erlang module lands on its clause in the
# module's file, and a record in Erlang on its -record in the header. The files are written here,
# not in the project, which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p erlshop/src erlshop/include erlshop/lib && printf -- '-record(order, {id, total = 0}).\n' > erlshop/include/shop.hrl && printf -- '-module(shop_order).\n-export([new/1, total/1]).\n\n-include("shop.hrl").\n\nnew(Id) ->\n    #order{id = Id}.\n\ntotal(#order{total = Total}) ->\n    Total.\n' > erlshop/src/shop_order.erl && printf 'defmodule Shop.Report do\n  def summary(id), do: :shop_order.total(:shop_order.new(id))\nend\n' > erlshop/lib/report.ex
key q
wait merl exited: 0
merl erlshop/lib/report.ex
wait defmodule Shop.Report
key /
type total(
key Enter d
wait total: via shop_order
merl erlshop/src/shop_order.erl
wait -module(shop_order)
key /
type order{id
key Enter d
wait order: by name, 1 match
key Escape
