# review-generated: a lock file is read once (#243). The agent bumps three dependencies in
# web/package-lock.json, three hunks apart, and touches worker/main.go. c lands on the lock file's
# first hunk and the status bar counts it as one; the next c goes on to main.go, and C comes back
# to the lock file's one stop.
merl README.md
wait # orders
run python3 -c 'import json; json.dump({"name": "orders", "packages": {f"dep-{i}": "1.0.0" for i in range(40)}}, open("web/package-lock.json", "w"), indent=2)' && git add -A && git commit -qm lock && git push -q origin main
run git switch -q -c deps && sed -i.bak -e 's/"dep-3": "1.0.0"/"dep-3": "1.1.0"/' -e 's/"dep-19": "1.0.0"/"dep-19": "1.2.0"/' -e 's/"dep-35": "1.0.0"/"dep-35": "2.0.0"/' web/package-lock.json && rm web/package-lock.json.bak && printf '\n// Retries back off: see the queue.\n' >> worker/main.go && git commit -qam 'deps: bump three'
merl --review
wait file 1/2
key c
wait hunk 1/1  file 2/2
key C
wait hunk 1/1  file 1/2
