# starlark-d: d in Starlark and Bazel (#431). A macro a BUILD file loads lands on its def in the
# .bzl the load names, and a ":api" label on the target's name line. The files are written here, not
# in the project, which every other scenario counts the files of.
merl
wait Open a file (fuzzy)
run mkdir -p bazelshop/tools bazelshop/api && printf 'module(name = "shop")\n' > bazelshop/MODULE.bazel && printf 'def shop_binary(name, srcs, **kwargs):\n    native.genrule(name = name + "_gen", srcs = srcs, outs = [name + ".out"])\n\nSHOP_VISIBILITY = ["//visibility:public"]\n' > bazelshop/tools/defs.bzl && printf 'load("//tools:defs.bzl", "shop_binary", "SHOP_VISIBILITY")\n\ngo_library(\n    name = "api",\n    srcs = ["api.go"],\n    visibility = SHOP_VISIBILITY,\n)\n\nshop_binary(\n    name = "server",\n    srcs = [":api"],\n)\n' > bazelshop/api/BUILD.bazel
key q
wait merl exited: 0
merl bazelshop/api/BUILD.bazel
wait shop_binary(
key /
type shop_binary(
key Enter d
wait shop_binary: via import
merl bazelshop/api/BUILD.bazel
wait shop_binary(
key /
type :api
key Enter d
wait api: target
key Escape
