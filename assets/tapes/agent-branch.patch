+func checkAssigneeCap(ctx context.Context, issue *issues_model.Issue) error {
+	count, err := issues_model.CountAssignees(ctx, issue.ID)
+	if err != nil {
+		return err
+	}
+	if count >= issues_model.MaxAssignees {
+		return util.NewInvalidArgumentErrorf("an issue takes %d assignees", issues_model.MaxAssignees)
+	}
+	return nil
+}
