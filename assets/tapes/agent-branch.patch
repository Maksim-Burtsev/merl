+// StarredRepoIDsOfOwner lists the repositories of one owner that a user has starred.
+func StarredRepoIDsOfOwner(ctx context.Context, starrerID, ownerID int64) ([]int64, error) {
+	repoIDs := make([]int64, 0, 25)
+	return repoIDs, db.GetEngine(ctx).Table("star").
+		Join("INNER", "repository", "repository.id = star.repo_id").
+		Where("star.uid = ?", starrerID).
+		And("repository.owner_id = ?", ownerID).
+		OrderBy("star.repo_id").
+		Cols("star.repo_id").
+		Find(&repoIDs)
+}
