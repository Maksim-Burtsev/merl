+// WatchedRepoIDsOfOwner lists the repositories of one owner that a user watches.
+func WatchedRepoIDsOfOwner(ctx context.Context, watcherID, ownerID int64) ([]int64, error) {
+	repoIDs := make([]int64, 0, 25)
+	return repoIDs, db.GetEngine(ctx).Table("watch").
+		Join("INNER", "repository", "repository.id = watch.repo_id").
+		Where("watch.user_id = ?", watcherID).
+		And("watch.mode <> ?", WatchModeDont).
+		And("repository.owner_id = ?", ownerID).
+		OrderBy("watch.repo_id").
+		Select("watch.repo_id").
+		Find(&repoIDs)
+}
