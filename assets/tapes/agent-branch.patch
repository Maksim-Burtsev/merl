+// MaxBlockingNoteLen is the longest note a blocking can carry.
+const MaxBlockingNoteLen = 255
+
+// TrimBlockingNote cuts a note down to what the column holds.
+func TrimBlockingNote(note string) string {
+	if len(note) > MaxBlockingNoteLen {
+		return note[:MaxBlockingNoteLen]
+	}
+	return note
+}
