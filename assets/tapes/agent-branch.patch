 // ToggleAssignee changes a user between assigned and not assigned for this issue, and make issue comment for it.
 func ToggleAssignee(ctx context.Context, issue *issues_model.Issue, doer, assignee *user_model.User) (removed bool, comment *issues_model.Comment, err error) {
+	// Refuse a new assignee when the issue has to many.
+	assigned, err := issues_model.IsUserAssignedToIssue(ctx, issue, assignee.ID)
+	if err != nil {
+		return false, nil, err
+	}
+	if !assigned {
+		if err = checkAssigneeCap(ctx, issue); err != nil {
+			return false, nil, err
+		}
+	}
