diff --git a/mealie/services/event_bus_service/retry.py b/mealie/services/event_bus_service/retry.py
new file mode 100644
index 0000000..5862b1d
--- /dev/null
+++ b/mealie/services/event_bus_service/retry.py
@@ -0,0 +1,42 @@
+import random
+import time
+
+import httpx
+
+from mealie.pkgs import safehttp
+
+RETRY_STATUSES = {429, 500, 502, 503, 504}
+BASE_DELAY = 1.0
+MAX_DELAY = 30.0
+
+
+def post_with_retry(url: str, *, attempts: int, **kwargs) -> httpx.Response:
+    """Posts to a webhook, trying again after a network error, a 429 or a 5xx.
+
+    Waits twice as long after every failed attempt, or as long as the receiver's
+    Retry-After asks, and gives up after `attempts`: the last response is returned.
+    """
+    attempt = 1
+    while True:
+        try:
+            r = safehttp.post(url, **kwargs)
+        except httpx.TransportError:
+            if attempt == attempts:
+                raise
+            retry_after = None
+        else:
+            if r.status_code not in RETRY_STATUSES or attempt == attempts:
+                return r
+            retry_after = r.headers.get("Retry-After")
+
+        time.sleep(backoff(attempt, retry_after))
+        attempt += 1
+
+
+def backoff(attempt: int, retry_after: str | None = None) -> float:
+    """Seconds to wait before the next attempt: Retry-After when the receiver sent it
+    in seconds, else 1, 2, 4, ... with a little jitter, never more than MAX_DELAY."""
+    delay = BASE_DELAY * 2 ** (attempt - 1)
+    if retry_after and retry_after.isdigit():
+        delay = float(retry_after)
+    return min(delay, MAX_DELAY) + random.uniform(0, 0.5)
diff --git a/tests/unit_tests/test_retry.py b/tests/unit_tests/test_retry.py
new file mode 100644
index 0000000..fde58c9
--- /dev/null
+++ b/tests/unit_tests/test_retry.py
@@ -0,0 +1,47 @@
+import httpx
+import pytest
+
+from mealie.services.event_bus_service import retry
+
+URL = "https://example.com/hook"
+
+
+def respond(*statuses: int, retry_after: str | None = None):
+    responses = iter(statuses)
+
+    def post(url, **kwargs):
+        headers = {"Retry-After": retry_after} if retry_after else {}
+        return httpx.Response(next(responses), headers=headers)
+
+    return post
+
+
+@pytest.fixture(autouse=True)
+def slept(monkeypatch):
+    waits = []
+    monkeypatch.setattr(retry.time, "sleep", waits.append)
+    return waits
+
+
+def test_retries_a_503_then_returns_the_success(monkeypatch, slept):
+    monkeypatch.setattr(retry.safehttp, "post", respond(503, 200))
+    assert retry.post_with_retry(URL, attempts=3).status_code == 200
+    assert len(slept) == 1
+
+
+def test_never_retries_a_client_error(monkeypatch, slept):
+    monkeypatch.setattr(retry.safehttp, "post", respond(404, 200))
+    assert retry.post_with_retry(URL, attempts=3).status_code == 404
+    assert slept == []
+
+
+def test_waits_as_long_as_retry_after_asks(monkeypatch, slept):
+    monkeypatch.setattr(retry.safehttp, "post", respond(429, 200, retry_after="7"))
+    retry.post_with_retry(URL, attempts=3)
+    assert 7 <= slept[0] < 7.5
+
+
+def test_gives_up_after_the_last_attempt(monkeypatch, slept):
+    monkeypatch.setattr(retry.safehttp, "post", respond(502, 502, 502))
+    assert retry.post_with_retry(URL, attempts=3).status_code == 502
+    assert len(slept) == 2
