+@router.get(
+    "/lookup",
+    summary="Look Up License Key",
+    response_model=LicenseKeyWithActivations,
+    tags=[APITag.mcp, APITag.cli],
+    responses={
+        401: UnauthorizedResponse,
+        404: NotFoundResponse,
+    },
+)
+async def lookup(
+    auth_subject: auth.LicenseKeysRead,
+    organization_id: OrganizationID,
+    key: str = Query(description="The key as the customer received it."),
+    session: AsyncReadSession = Depends(get_db_read_session),
+) -> LicenseKey:
+    """Find a license key by the key a customer holds, e.g. one quoted in a support email."""
+    lk = await license_key_service.get_by_key(
+        session, auth_subject, organization_id=organization_id, key=key
+    )
+    if not lk:
+        raise ResourceNotFound()
+
+    return lk
+
