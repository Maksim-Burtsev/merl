+@pytest.mark.asyncio
+class TestLookupLicenseKey:
+    async def test_anonymous(self, client: AsyncClient) -> None:
+        response = await client.get("/v1/license-keys/lookup")
+
+        assert response.status_code == 401
+
+    @pytest.mark.auth
+    async def test_user_cannot_look_up_other_organization_license_key(
+        self,
+        client: AsyncClient,
+        user_organization: UserOrganization,
+        license_key_organization_second: LicenseKey,
+    ) -> None:
+        lk = license_key_organization_second
+        response = await client.get(
+            "/v1/license-keys/lookup",
+            params={"organization_id": str(lk.organization_id), "key": lk.key},
+        )
+
+        assert response.status_code == 404
+
+    @pytest.mark.auth
+    async def test_look_up(
+        self,
+        session: AsyncSession,
+        redis: Redis,
+        client: AsyncClient,
+        save_fixture: SaveFixture,
+        user_organization: UserOrganization,
+        organization: Organization,
+        product: Product,
+        customer: Customer,
+    ) -> None:
+        _, granted = await TestLicenseKey.create_benefit_and_grant(
+            session,
+            redis,
+            save_fixture,
+            customer=customer,
+            organization=organization,
+            product=product,
+            properties=BenefitLicenseKeysCreateProperties(prefix="testing"),
+        )
+        lk = await LicenseKeyRepository.from_session(session).get_by_id(
+            UUID(granted["license_key_id"])
+        )
+        assert lk is not None
+
+        response = await client.get(
+            "/v1/license-keys/lookup",
+            params={"organization_id": str(organization.id), "key": lk.key},
+        )
+
+        assert response.status_code == 200
+        assert response.json()["id"] == str(lk.id)
+
