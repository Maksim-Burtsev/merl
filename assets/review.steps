# The reviewing half: an agent's branch of polar, four files. c walks the hunks; from the new
# endpoint d goes down through the service and the repository to the model, and one c brings the
# review back; the same refactor three times takes a c each; u checks who calls the new method.
project polar
merl --review
wait hunk 1/9
sleep 0.5
show
sleep 1.9

# c: the imports the refactor dropped, then the new endpoint, read whole
key c
wait hunk 2/9
sleep 0.9
key c
wait hunk 3/9
sleep 2.4

# } to the end of the endpoint, up to its call, word by word onto the method, d
key }
sleep 0.2
key@0.14 Up*3
sleep 0.2
key@0.2 M-Right*4
sleep 0.2
key d
wait LicenseKeyService.get_by_key_or_raise
sleep 2.0

# the service: } to its lookup, onto the repository method, d
key }
sleep 0.2
key Down
sleep 0.2
key@0.2 M-Right*4
sleep 0.2
key d
wait LicenseKeyRepository.get_readable_by_key
sleep 1.6

# the repository filters on the model: find it in the file, d, and a glance down its columns
key /
sleep 0.1
type@0.05 LicenseKey.k
sleep 0.4
key Enter
sleep 0.2
key d
wait via import
sleep 1.1
key C-d
sleep 0.9
key C-d
sleep 1.1

# c: back to the endpoint the dive started from
key c
wait hunk 3/9
sleep 1.3

# the refactor in validate, activate and deactivate: the same change, a c or two each
key c
wait hunk 4/9
sleep 2.0
key c
wait hunk 5/9
sleep 0.5
key c
wait hunk 6/9
sleep 1.0
key c
wait hunk 7/9
sleep 0.4
key c
wait hunk 8/9
sleep 0.8
key c
wait hunk 9/9
sleep 0.4

# the new service method: u, who calls it now
key c
wait file 2/4
sleep 0.6
key@0.2 M-Right*3
sleep 0.2
key u
wait Usages of
sleep 2.2
key Escape
sleep 0.2

# and its tests, skimmed half a page at a time
key c
wait file 3/4
sleep 1.1
key C-d
sleep 1.0
key C-d
sleep 2.0
