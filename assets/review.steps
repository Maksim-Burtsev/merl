# The reviewing half: the agent's branch, from a hunk into the code it calls and back, one fix.
merl --review
wait hunk 1/1
sleep 0.5
show
sleep 2.5

# c: on into the next file, where a function body was rewritten; the old lines stand as ghosts
key c
wait hunk 1/5
sleep 3

# onto the new call with the arrows, d goes into the helper the branch added, [ comes back
key Down
sleep 0.5
key@0.04 Right*28
sleep 1
key d
wait via import
sleep 3
key [
wait file 2/2
sleep 1.5

# a typo in the comment one line up: Enter edits, Esc saves
key Up
sleep 0.4
key@0.03 Right*45
sleep 0.8
key Enter
sleep 0.8
type r
sleep 1.2
key Escape
sleep 1.5
