# The reviewing half: an agent's branch of four files, walked hunk by hunk, once into the code it calls.
project mealie
merl --review
wait hunk 1/1
sleep 0.5
show
sleep 2.6

# c walks the hunks: the new setting, then the publisher, where the call changed
key c
wait hunk 1/3
sleep 1.6
key c
wait hunk 2/3
sleep 1.4

# Alt+Right along the line onto the new call, d into the helper the branch added, read it
key@0.35 M-Right*2
sleep 0.9
key d
wait via import
sleep 1.8
key@0.4 Down*9
sleep 2.4

# [ back to the hunk, and c on: the rest of the publisher, the helper, its test
key [
wait hunk 2/3
sleep 1.4
key c
wait hunk 3/3
sleep 1.6
key c
wait file 3/4
sleep 2
key c
wait file 4/4
sleep 3
