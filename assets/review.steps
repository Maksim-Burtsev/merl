# The reviewing half: an agent's branch of polar, three files. c walks the hunks; from the
# refactored validate, d goes down through the service and the repository to the model, and one c
# brings the review back; u checks who calls the new method; the tests are read whole. Every move
# goes one way, onto what it reads next.
project polar
merl --review
wait hunk 1/9
sleep 0.5
show
sleep 1.8

# c: the imports the refactor dropped, then the new endpoint, read whole
key c
wait hunk 2/9
sleep 0.8
key c
wait hunk 3/9
sleep 2.4

# c: validate drops its lookup for the service's; the cursor is on the call: onto the method, d
key c
wait hunk 4/9
sleep 2.0
key@0.18 M-Right*4
sleep 0.3
key d
wait LicenseKeyService.get_by_key_or_raise
sleep 2.0

# the service: } to its lookup, onto the repository method, d
key }
sleep 0.3
key Down
sleep 0.3
key@0.18 M-Right*4
sleep 0.3
key d
wait LicenseKeyRepository.get_readable_by_key
sleep 1.6

# the repository filters on the model: / finds it, d
key /
sleep 0.2
type@0.05 LicenseKey.k
sleep 0.4
key Enter
sleep 0.3
key d
wait via import
sleep 1.9

# c: back to validate, where the dive started, and on through activate and deactivate
key c
wait hunk 4/9
sleep 1.2
key c
wait hunk 5/9
sleep 0.6
key c
wait hunk 6/9
sleep 1.0
key c
wait hunk 7/9
sleep 0.5
key c
wait hunk 8/9
sleep 0.9
key c
wait hunk 9/9
sleep 0.5

# the new service method: u, who calls it now
key c
wait file 2/3
sleep 0.7
key@0.18 M-Right*3
sleep 0.3
key u
wait Usages of
sleep 2.4
key Escape
sleep 0.3

# the tests, read whole: Ctrl+D brings the class to the top, Ctrl+D again shows its last test;
# c on the last hunk says the review is done and ticks the last file
key c
wait file 3/3
sleep 1.0
key C-d
sleep 2.4
key C-d
sleep 2.8
key c
wait last hunk of the review
sleep 2.4
