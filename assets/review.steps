# The reviewing half: an agent's branch of polar, three files. d follows the new endpoint down
# through the service and the repository to the model, and c brings the review back in one key.
project polar
merl --review
wait hunk 1/1
sleep 0.5
show
sleep 2.2

# the new endpoint: down to its call, End and Alt+Left onto the service method, d
key@0.04 Down*17
sleep 0.6
key End M-Left
sleep 0.5
key d
wait LicenseKeyService.get_by_key
sleep 1.8

# the service asks the repository: d again
key@0.04 Down*12
sleep 0.5
key End M-Left
sleep 0.5
key d
wait LicenseKeyRepository.get_readable_by_key
sleep 1.6

# the repository filters on the model: d on it, and a look at its fields
key@0.04 Down*11
sleep 0.4
key M-Right
sleep 0.4
key d
wait via import
sleep 1.4
key@0.04 Down*30
sleep 1.4

# c: back to the hunk the dive started from, then on through the service and the test
key c
wait file 1/3
sleep 1.8
key c
wait file 2/3
sleep 1.6
key c
wait file 3/3
sleep 2.6
